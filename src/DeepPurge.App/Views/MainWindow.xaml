<Window x:Class="DeepPurge.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DeepPurge.App.ViewModels"
        xmlns:conv="clr-namespace:DeepPurge.App.Converters"
        xmlns:props="clr-namespace:DeepPurge.App.Properties"
        Title="DeepPurge v0.9.1" Width="1440" Height="900"
        MinWidth="1060" MinHeight="700" WindowStartupLocation="CenterScreen"
        Style="{DynamicResource MainWindowStyle}">

    <Window.Resources>
        <FontFamily x:Key="Ico">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:StringToVisibilityConverter x:Key="BadgeVisConverter"/>
        <conv:BytesToSizeConverter x:Key="BytesToSizeConverter"/>
        <conv:BoolToOldBadgeConverter x:Key="BoolToOldBadgeConverter"/>
        <conv:PathListJoinConverter x:Key="PathListJoinConverter"/>
        <conv:FirstOrEmptyConverter x:Key="FirstOrEmptyConverter"/>
        <conv:CountConverter x:Key="CountConverter"/>
        <conv:CollectionEmptyToVisibilityConverter x:Key="EmptyCollectionVisConverter"/>
        <conv:PanelEmptyStateVisibilityConverter x:Key="PanelEmptyStateVisConverter"/>

        <!-- ══ NAV BUTTON ══ -->
        <Style x:Key="NavRadioButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Subtext0Brush}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="8,1,10,1"/>
            <Setter Property="FocusVisualStyle" Value="{DynamicResource DeepPurgeFocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Border x:Name="indicator" Width="2" HorizontalAlignment="Left" CornerRadius="0,2,2,0"
                                    Background="{DynamicResource AccentBrush}" Opacity="0" Margin="-8,7,0,7"/>
                            <Border x:Name="bg" Padding="11,8,12,8" CornerRadius="6" Background="Transparent"
                                    BorderBrush="Transparent" BorderThickness="2">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bg" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="{DynamicResource AccentColor}" Opacity="0.16"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="indicator" Property="Opacity" Value="1"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="bg" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="{DynamicResource TextColor}" Opacity="0.04"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Foreground" Value="{DynamicResource SubtextBrush}"/>
                            </MultiTrigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Subtext0Brush}"/>
            <Setter Property="Margin" Value="18,16,0,6"/>
            <Setter Property="Opacity" Value="0.72"/>
        </Style>

        <Style x:Key="NavIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Ico}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Width" Value="22"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Opacity" Value="0.7"/>
        </Style>

        <!-- Badge pill for nav items -->
        <Style x:Key="NavBadge" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Surface1Brush}"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="6,1"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="NavBadgeText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Subtext0Brush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Scan progress bar under nav items -->
        <Style x:Key="NavProgressBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="2"/>
            <Setter Property="Margin" Value="12,2,14,0"/>
            <Setter Property="Background" Value="{DynamicResource Surface0Brush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}" CornerRadius="1" ClipToBounds="True">
                            <Grid>
                                <Border x:Name="PART_Track"/>
                                <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}"
                                        CornerRadius="1" HorizontalAlignment="Left"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Compact segmented selector used for scan risk. -->
        <Style x:Key="ScanModeRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource SubtextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="MinWidth" Value="76"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{DynamicResource DeepPurgeFocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="modeBg" Background="{TemplateBinding Background}"
                                BorderBrush="Transparent" BorderThickness="1" CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="modeBg" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource ActionForegroundBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="modeBg" Property="BorderBrush" Value="{DynamicResource Surface2Brush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="modeBg" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="modeBg" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MetricCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource MantleBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Surface1Brush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,12"/>
        </Style>

        <Style x:Key="MetricEyebrow" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Subtext0Brush}"/>
            <Setter Property="FontSize" Value="9.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Opacity" Value="0.8"/>
        </Style>

        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="TableBadge" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Surface0Brush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Surface1Brush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="7,3"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SignatureTone" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource GreenBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SignatureDisplay}" Value="Unsigned">
                    <Setter Property="Foreground" Value="{DynamicResource YellowBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding SignatureDisplay}" Value="Missing">
                    <Setter Property="Foreground" Value="{DynamicResource Subtext0Brush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding SignatureDisplay}" Value="Invalid">
                    <Setter Property="Foreground" Value="{DynamicResource RedBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding SignatureDisplay}" Value="Untrusted">
                    <Setter Property="Foreground" Value="{DynamicResource RedBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding SignatureDisplay}" Value="Revoked">
                    <Setter Property="Foreground" Value="{DynamicResource RedBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PanelSubtitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Subtext0Brush}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- Master Checkbox Header Template -->
        <DataTemplate x:Key="MasterCheckboxHeader">
            <CheckBox x:Name="masterCb" HorizontalAlignment="Center" VerticalAlignment="Center"
                      Click="MasterCheckbox_Click" ToolTip="Select All / None"/>
        </DataTemplate>

        <!-- ══ CONTEXT MENU STYLE ══ -->
        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource MantleBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Surface1Brush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="{StaticResource UIFont}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.4" Color="#000000"/>
                            </Border.Effect>
                            <StackPanel IsItemsHost="True"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="{StaticResource UIFont}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}" Margin="2,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="icon" Text="{TemplateBinding Tag}" FontFamily="{StaticResource Ico}" FontSize="12"
                                           Foreground="{DynamicResource Subtext0Brush}" VerticalAlignment="Center"/>
                                <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Surface0Brush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource Subtext0Brush}"/>
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MenuSep" TargetType="Separator">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="8,4"/>
            <Setter Property="Background" Value="{DynamicResource Surface0Brush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Background="{TemplateBinding Background}" Height="1" Margin="{TemplateBinding Margin}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Icon+Name cell template for programs DataGrid -->
        <DataTemplate x:Key="IconNameCell">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="28" Height="28" CornerRadius="6" Margin="0,0,12,0" VerticalAlignment="Center">
                    <Border.Background>
                        <SolidColorBrush Color="{DynamicResource Surface0Color}"/>
                    </Border.Background>
                    <Image Source="{Binding Icon}" Width="20" Height="20"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </DataTemplate>

        <CubicEase x:Key="EaseOut" EasingMode="EaseOut"/>

    </Window.Resources>

    <!-- ════════════════════════════════════════════════════════════════ -->
    <!-- ROOT GRID -->
    <!-- ════════════════════════════════════════════════════════════════ -->
    <Grid Background="{DynamicResource CrustBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="228"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- SIDEBAR -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <Border Grid.Column="0" Background="{DynamicResource MantleBrush}"
                BorderBrush="{DynamicResource Surface0Brush}" BorderThickness="0,0,1,0">
            <Border>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#06FFFFFF" Offset="0"/>
                        <GradientStop Color="#00FFFFFF" Offset="0.3"/>
                        <GradientStop Color="#03000000" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <DockPanel>
                    <!-- BRAND -->
                    <Border DockPanel.Dock="Top" Padding="18,20,14,17">
                        <DockPanel>
                            <!-- Theme Toggle (Sun/Moon) -->
                            <Button x:Name="btnThemeToggle" DockPanel.Dock="Right" Click="ThemeToggle_Click"
                                    VerticalAlignment="Center" Cursor="Hand" ToolTip="Toggle Light/Dark"
                                    AutomationProperties.Name="Toggle light or dark theme"
                                    AutomationProperties.HelpText="Switch between the light Arctic theme and the default dark theme."
                                    Width="32" Height="32">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="toggleBg" Background="{DynamicResource Surface0Brush}"
                                                BorderBrush="{DynamicResource Surface1Brush}" BorderThickness="1"
                                                CornerRadius="6" Width="32" Height="32">
                                            <TextBlock x:Name="toggleIcon" Text="&#xE706;" FontFamily="{StaticResource Ico}" FontSize="15"
                                                       Foreground="{DynamicResource SubtextBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="toggleBg" Property="Background" Value="{DynamicResource Surface1Brush}"/>
                                                <Setter TargetName="toggleIcon" Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="36" Height="36" CornerRadius="8" Margin="0,0,12,0">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="{DynamicResource AccentColor}" Offset="0"/>
                                            <GradientStop Color="{DynamicResource TealColor}" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <TextBlock Text="&#xE74D;" FontFamily="{StaticResource Ico}" FontSize="17"
                                               Foreground="{StaticResource ActionForegroundBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="DeepPurge" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                                    <TextBlock Text="LOCAL SYSTEM CARE" FontSize="8.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Subtext0Brush}" Margin="0,2,0,0" Opacity="0.75"/>
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Border DockPanel.Dock="Top" Height="1" Margin="20,0" Background="{DynamicResource Surface0Brush}" Opacity="0.6"/>

                    <!-- FOOTER -->
                    <Border DockPanel.Dock="Bottom" Padding="16,12,16,16">
                        <StackPanel>
                            <Border Height="1" Background="{DynamicResource Surface0Brush}" Opacity="0.6" Margin="0,0,0,12"/>
                            <DockPanel Margin="4,0,0,6">
                                <TextBlock DockPanel.Dock="Right" FontSize="9.5" Foreground="{DynamicResource Subtext0Brush}"
                                           Opacity="0.55" Text="{Binding AppVersionDisplay, StringFormat=v{0}}"/>
                                <TextBlock Text="THEME" FontSize="9.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Subtext0Brush}" Margin="4,0,0,6" Opacity="0.5"/>
                            </DockPanel>
                            <ComboBox x:Name="cmbTheme" SelectionChanged="Theme_SelectionChanged" FontSize="11.5"
                                      AutomationProperties.Name="Application theme"/>
                            <Border Background="{DynamicResource Surface0Brush}" CornerRadius="8"
                                    Padding="12,7" Margin="0,10,0,0" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xEA37;" FontFamily="{StaticResource Ico}" FontSize="12"
                                               Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding ProgramCountText}" FontSize="11"
                                               Foreground="{DynamicResource SubtextBrush}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- NAV -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                        <StackPanel>
                            <TextBlock Text="UNINSTALL" Style="{StaticResource SectionLabel}"/>

                            <!-- Installed Programs + badge -->
                            <RadioButton x:Name="navPrograms" GroupName="nav" IsChecked="True" Checked="NavButton_Checked" Tag="Programs"
                                         Style="{StaticResource NavRadioButton}">
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" Style="{StaticResource NavBadge}"
                                            Visibility="{Binding ProgramsBadge, Converter={StaticResource BadgeVisConverter}}">
                                        <TextBlock Text="{Binding ProgramsBadge}" Style="{StaticResource NavBadgeText}"/>
                                    </Border>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE74C;" Style="{StaticResource NavIcon}"/>
                                        <TextBlock Text="{x:Static props:Resources.Nav_InstalledPrograms}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DockPanel>
                            </RadioButton>
                            <ProgressBar Value="{Binding ProgramsScanProgress}" Style="{StaticResource NavProgressBar}"/>

                            <RadioButton x:Name="navForced" GroupName="nav" Tag="Forced"
                                         Checked="NavButton_Checked" Style="{StaticResource NavRadioButton}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE71C;" Style="{StaticResource NavIcon}"/>
                                    <TextBlock Text="Forced Uninstall" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton GroupName="nav" Tag="WindowsApps" Checked="NavButton_Checked" Style="{StaticResource NavRadioButton}">
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" Style="{StaticResource NavBadge}"
                                            Visibility="{Binding WindowsAppsBadge, Converter={StaticResource BadgeVisConverter}}">
                                        <TextBlock Text="{Binding WindowsAppsBadge}" Style="{StaticResource NavBadgeText}"/>
                                    </Border>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE71D;" Style="{StaticResource NavIcon}"/>
                                        <TextBlock Text="Windows Apps" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DockPanel>
                            </RadioButton>

                            <TextBlock Text="CLEANUP" Style="{StaticResource SectionLabel}"/>

                            <!-- Junk Cleaner + badge -->
                            <RadioButton GroupName="nav" Tag="Junk" Checked="NavButton_Checked" Style="{StaticResource NavRadioButton}">
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" Style="{StaticResource NavBadge}"
                                            Visibility="{Binding JunkBadge, Converter={StaticResource BadgeVisConverter}}">
                                        <TextBlock Text="{Binding JunkBadge}" Style="{StaticResource NavBadgeText}"
                                                   Foreground="{DynamicResource PeachBrush}"/>
                                    </Border>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE74D;" Style="{StaticResource NavIcon}"/>
                                        <TextBlock Text="{x:Static props:Resources.Nav_JunkCleaner}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DockPanel>
                            </RadioButton>
                            <ProgressBar Value="{Binding JunkScanProgress}" Style="{StaticResource NavProgressBar}"/>

                            <RadioButton GroupName="nav" Tag="Evidence" Checked="NavButton_Checked" Style="{StaticResource NavRadioButton}">
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" Style="{StaticResource NavBadge}"
                                            Visibility="{Binding EvidenceBadge, Converter={StaticResource BadgeVisConverter}}">
                                        <TextBlock Text="{Binding EvidenceBadge}" Style="{StaticResource NavBadgeText}"/>
                                    </Border>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE72E;" Style="{StaticResource NavIcon}"/>
                                        <TextBlock Text="{x:Static props:Resources.Nav_EvidenceRemover}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DockPanel>
                            </RadioButton>

                            <RadioButton GroupName="nav" Tag="EmptyFolders" Checked="NavButton_Checked" Style="{StaticResource NavRadioButton}">
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" Style="{StaticResource NavBadge}"
                                            Visibility="{Binding EmptyFoldersBadge, Converter={StaticResource BadgeVisConverter}}">
                                        <TextBlock Text="{Binding EmptyFoldersBadge}" Style="{StaticResource NavBadgeText}"/>
                                    </Border>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8B7;" Style="{StaticResource NavIcon}"/>
                                        <TextBlock Text="Empty Folders" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DockPanel>
                            </RadioButton>

                            <RadioButton GroupName="nav" Tag="Disk" Checked="NavButton_Checked" Style="{StaticResource NavRadioButton}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xEDA2;" Style="{StaticResource NavIcon}"/>
                                    <TextBlock Text="Disk Analyzer" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <TextBlock Text="SYSTEM" Style="{StaticResource SectionLabel}"/>

                            <RadioButton GroupName="nav" Tag="Autorun" Checked="NavButton_Checked" Style="{StaticResource NavRadioButton}">
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" Style="{StaticResource NavBadge}"
                                            Visibility="{Binding AutorunBadge, Converter={StaticResource BadgeVisConverter}}">
                                        <TextBlock Text="{Binding AutorunBadge}" Style="{StaticResource NavBadgeText}"/>
                                    </Border>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE768;" Style="{StaticResource NavIcon}"/>
                                        <TextBlock Text="{x:Static props:Resources.Nav_AutorunManager}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DockPanel>
                            </RadioButton>

                            <RadioButton GroupName="nav" Tag="BrowserExt" Checked="NavButton_Checked" Style="{StaticResource NavRadioButton}">
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" Style="{StaticResource NavBadge}"
                                            Visibility="{Binding BrowserExtBadge, Converter={StaticResource BadgeVisConverter}}">
                                        <TextBlock Text="{Binding BrowserExtBadge}" Style="{StaticResource NavBadgeText}"/>
                                    </Border>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE774;" Style="{StaticResource NavIcon}"/>
                                        <TextBlock Text="Browser Extensions" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DockPanel>
                            </RadioButton>

                            <RadioButton GroupName="nav" Tag="ContextMenu" Checked="NavButton_Checked" Style="{StaticResource NavRadioButton}">
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" Style="{StaticResource NavBadge}"
                                            Visibility="{Binding ContextMenuBadge, Converter={StaticResource BadgeVisConverter}}">
                                        <TextBlock Text="{Binding ContextMenuBadge}" Style="{StaticResource NavBadgeText}"/>
                                    </Border>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE762;" Style="{StaticResource NavIcon}"/>
                                        <TextBlock Text="Context Menu" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DockPanel>
                            </RadioButton>

                            <RadioButton GroupName="nav" Tag="Services" Checked="NavButton_Checked" Style="{StaticResource NavRadioButton}">
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" Style="{StaticResource NavBadge}"
                                            Visibility="{Binding ServicesBadge, Converter={StaticResource BadgeVisConverter}}">
                                        <TextBlock Text="{Binding ServicesBadge}" Style="{StaticResource NavBadgeText}"/>
                                    </Border>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE912;" Style="{StaticResource NavIcon}"/>
                                        <TextBlock Text="Services" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DockPanel>
                            </RadioButton>

                            <!-- Scheduled Tasks + badge -->
                            <RadioButton GroupName="nav" Tag="Tasks" Checked="NavButton_Checked" Style="{StaticResource NavRadioButton}">
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" Style="{StaticResource NavBadge}"
                                            Visibility="{Binding TasksBadge, Converter={StaticResource BadgeVisConverter}}">
                                        <TextBlock Text="{Binding TasksBadge}" Style="{StaticResource NavBadgeText}"/>
                                    </Border>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE823;" Style="{StaticResource NavIcon}"/>
                                        <TextBlock Text="Scheduled Tasks" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DockPanel>
                            </RadioButton>
                            <ProgressBar Value="{Binding TasksScanProgress}" Style="{StaticResource NavProgressBar}"/>

                            <RadioButton GroupName="nav" Tag="Hunter" Checked="NavButton_Checked" Style="{StaticResource NavRadioButton}"
                                         Visibility="{Binding ExpertMode, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE721;" Style="{StaticResource NavIcon}"/>
                                    <TextBlock Text="Registry Hunter" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton GroupName="nav" Tag="Orphans" Checked="NavButton_Checked" Style="{StaticResource NavRadioButton}">
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" Style="{StaticResource NavBadge}"
                                            Visibility="{Binding OrphanBadge, Converter={StaticResource BadgeVisConverter}}">
                                        <TextBlock Text="{Binding OrphanBadge}" Style="{StaticResource NavBadgeText}"
                                                   Foreground="{DynamicResource PeachBrush}"/>
                                    </Border>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE7BA;" Style="{StaticResource NavIcon}"/>
                                        <TextBlock Text="Orphaned Artifacts" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DockPanel>
                            </RadioButton>

                            <TextBlock Text="SAFETY" Style="{StaticResource SectionLabel}"/>
                            <RadioButton GroupName="nav" Tag="Restore" Checked="NavButton_Checked" Style="{StaticResource NavRadioButton}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE777;" Style="{StaticResource NavIcon}"/>
                                    <TextBlock Text="Restore Points" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton GroupName="nav" Tag="DeletionRecovery" Checked="NavButton_Checked" Style="{StaticResource NavRadioButton}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8BB;" Style="{StaticResource NavIcon}"/>
                                    <TextBlock Text="Deletion Recovery" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton GroupName="nav" Tag="Backups" Checked="NavButton_Checked" Style="{StaticResource NavRadioButton}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7B8;" Style="{StaticResource NavIcon}"/>
                                    <TextBlock Text="Registry Backups" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <!-- ═══════════════════════════════════════════════════════ -->
                            <!-- SYSTEM TOOLS (v0.9.1) — optional scans, run on demand  -->
                            <!-- ═══════════════════════════════════════════════════════ -->
                            <TextBlock Text="SYSTEM TOOLS" Style="{StaticResource SectionLabel}"/>

                            <RadioButton GroupName="nav" Tag="Drivers" Checked="NavButton_Checked" Style="{StaticResource NavRadioButton}">
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" Style="{StaticResource NavBadge}"
                                            Visibility="{Binding DriverBadge, Converter={StaticResource BadgeVisConverter}}">
                                        <TextBlock Text="{Binding DriverBadge}" Style="{StaticResource NavBadgeText}"/>
                                    </Border>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE950;" Style="{StaticResource NavIcon}"/>
                                        <TextBlock Text="{x:Static props:Resources.Nav_DriverStore}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DockPanel>
                            </RadioButton>

                            <RadioButton GroupName="nav" Tag="StartupImpact" Checked="NavButton_Checked" Style="{StaticResource NavRadioButton}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE945;" Style="{StaticResource NavIcon}"/>
                                    <TextBlock Text="Startup Impact" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton GroupName="nav" Tag="Shortcuts" Checked="NavButton_Checked" Style="{StaticResource NavRadioButton}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE71B;" Style="{StaticResource NavIcon}"/>
                                    <TextBlock Text="Broken Shortcuts" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton GroupName="nav" Tag="Duplicates" Checked="NavButton_Checked" Style="{StaticResource NavRadioButton}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8C8;" Style="{StaticResource NavIcon}"/>
                                    <TextBlock Text="Duplicate Files" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton GroupName="nav" Tag="Winapp2" Checked="NavButton_Checked" Style="{StaticResource NavRadioButton}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE90F;" Style="{StaticResource NavIcon}"/>
                                    <TextBlock Text="Community Cleaners" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton GroupName="nav" Tag="Repair" Checked="NavButton_Checked" Style="{StaticResource NavRadioButton}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE90F;" Style="{StaticResource NavIcon}"/>
                                    <TextBlock Text="{x:Static props:Resources.Nav_RepairWindows}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton GroupName="nav" Tag="Schedule" Checked="NavButton_Checked" Style="{StaticResource NavRadioButton}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE823;" Style="{StaticResource NavIcon}"/>
                                    <TextBlock Text="Scheduled Cleaning" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton GroupName="nav" Tag="InstallMonitor" Checked="NavButton_Checked" Style="{StaticResource NavRadioButton}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8B5;" Style="{StaticResource NavIcon}"/>
                                    <TextBlock Text="Install Monitor" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton GroupName="nav" Tag="Health" Checked="NavButton_Checked" Style="{StaticResource NavRadioButton}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE9D9;" Style="{StaticResource NavIcon}"/>
                                    <TextBlock Text="Health Dashboard" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton GroupName="nav" Tag="Slimming" Checked="NavButton_Checked" Style="{StaticResource NavRadioButton}"
                                         Visibility="{Binding ExpertMode, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7F4;" Style="{StaticResource NavIcon}"/>
                                    <TextBlock Text="System Slimming" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton GroupName="nav" Tag="History" Checked="NavButton_Checked" Style="{StaticResource NavRadioButton}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE81C;" Style="{StaticResource NavIcon}"/>
                                    <TextBlock Text="{x:Static props:Resources.Nav_History}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton GroupName="nav" Tag="Settings" Checked="NavButton_Checked" Style="{StaticResource NavRadioButton}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE713;" Style="{StaticResource NavIcon}"/>
                                    <TextBlock Text="Settings / Privacy" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton GroupName="nav" Tag="About" Checked="NavButton_Checked" Style="{StaticResource NavRadioButton}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE946;" Style="{StaticResource NavIcon}"/>
                                    <TextBlock Text="{x:Static props:Resources.Nav_About}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Border>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- MAIN CONTENT -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ── TOOLBAR: PROGRAMS ── -->
            <Border Grid.Row="0" x:Name="toolbarMain" Padding="28,22,28,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="18"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Installed programs" FontSize="25" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock Text="Review software, source trust, and recovery impact before removal."
                                       Style="{StaticResource PanelSubtitle}"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="{DynamicResource MantleBrush}"
                                BorderBrush="{DynamicResource GreenBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="12,8" VerticalAlignment="Center"
                                AutomationProperties.Name="Local-only readiness status">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE73E;" FontFamily="{StaticResource Ico}" FontSize="12"
                                           Foreground="{DynamicResource GreenBrush}" Margin="0,0,8,0"/>
                                <TextBlock Text="LOCAL · ON-DEVICE" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{DynamicResource GreenBrush}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{DynamicResource BaseBrush}"
                                CornerRadius="7" Height="38"
                                BorderBrush="{DynamicResource Surface1Brush}" BorderThickness="1">
                            <Grid>
                                <TextBlock Text="&#xE721;" FontFamily="{StaticResource Ico}" FontSize="14"
                                           Foreground="{DynamicResource Subtext0Brush}"
                                           HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0"
                                           IsHitTestVisible="False"/>
                                <TextBlock x:Name="txtSearchHint" Text="Search apps, publishers, or sources"
                                           Foreground="{DynamicResource Subtext0Brush}" FontSize="12"
                                           HorizontalAlignment="Left" VerticalAlignment="Center" Margin="36,0,10,0"
                                           IsHitTestVisible="False" Opacity="0.7"/>
                                <TextBox x:Name="txtSearch" Background="Transparent" BorderThickness="0"
                                         Padding="36,9,12,9" TextChanged="SearchBox_TextChanged" FontSize="12.5"
                                         AutomationProperties.Name="Search installed programs"
                                         AutomationProperties.HelpText="Filter by application name, publisher, source, or package ID."/>
                            </Grid>
                        </Border>

                        <WrapPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <Border Background="{DynamicResource BaseBrush}" CornerRadius="7" Padding="3"
                                    Margin="0,0,8,8" BorderBrush="{DynamicResource Surface1Brush}" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="rbSafe" Content="Safe" GroupName="scanMode"
                                                 Style="{StaticResource ScanModeRadio}"/>
                                    <RadioButton x:Name="rbModerate" Content="Moderate" GroupName="scanMode"
                                                 IsChecked="True" Style="{StaticResource ScanModeRadio}"/>
                                    <RadioButton x:Name="rbAdvanced" Content="Advanced" GroupName="scanMode"
                                                 Style="{StaticResource ScanModeRadio}"
                                                 Visibility="{Binding ExpertMode, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </Border>
                            <Button x:Name="btnExport" Content="Export" Click="Export_Click"
                                    Style="{DynamicResource GhostButton}" Margin="0,0,6,8"/>
                            <Button x:Name="btnRefresh" Content="Refresh" Click="Refresh_Click"
                                    Style="{DynamicResource GhostButton}" Margin="0,0,6,8"/>
                            <Button x:Name="btnScanLeftovers" Content="Scan leftovers" Click="ScanLeftovers_Click"
                                    Margin="0,0,6,8"/>
                            <Button x:Name="btnUninstall" Content="Uninstall" Click="Uninstall_Click"
                                    Style="{DynamicResource AccentButton}" Margin="0,0,6,8"
                                    IsEnabled="{Binding SelectedItem.CanUninstall, ElementName=dgPrograms, FallbackValue=False}"/>
                            <Button x:Name="btnBulkUninstall" Content="Uninstall selected" Click="BulkUninstall_Click"
                                    Style="{DynamicResource DangerButton}" Margin="0,0,6,8"
                                    ToolTip="Uninstall every program with a checkbox. Silent flags applied automatically."/>
                            <Button x:Name="btnDeleteLeftovers" Content="Delete selected" Click="DeleteLeftovers_Click"
                                    Style="{DynamicResource DangerButton}" IsEnabled="False" Margin="0,0,0,8"
                                    Visibility="{Binding IsEnabled, RelativeSource={RelativeSource Self}, Converter={StaticResource BoolToVis}}"/>
                        </WrapPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- ── TOOLBAR: GENERIC ── -->
            <Border Grid.Row="0" x:Name="toolbarGeneric" Padding="28,22,28,16" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="txtPanelTitle" FontSize="25" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}"/>
                        <TextBlock x:Name="txtPanelSubtitle" Style="{StaticResource PanelSubtitle}"/>
                    </StackPanel>
                    <WrapPanel x:Name="genericButtons" Grid.Row="2" HorizontalAlignment="Right"
                               VerticalAlignment="Center" AutomationProperties.Name="Panel actions"/>
                </Grid>
            </Border>

            <!-- ── CONTENT CARD ── -->
            <Border Grid.Row="1" Margin="20,2,20,0" CornerRadius="10,10,0,0" ClipToBounds="True"
                    Background="{DynamicResource BaseBrush}"
                    BorderBrush="{DynamicResource Surface0Brush}" BorderThickness="1,1,1,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.14" Color="#000000" Direction="270"/>
                </Border.Effect>
                <Grid>
                    <!-- Subtle top gradient -->
                    <Border Height="48" VerticalAlignment="Top" IsHitTestVisible="False" CornerRadius="10,10,0,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#08FFFFFF" Offset="0"/>
                                <GradientStop Color="#00FFFFFF" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <!-- PROGRAMS -->
                    <Grid Height="84" Margin="14,12,14,0" VerticalAlignment="Top" Panel.ZIndex="2"
                          Visibility="{Binding ElementName=dgPrograms, Path=Visibility}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource MetricCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="38"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="32" Height="32" CornerRadius="6" VerticalAlignment="Center"
                                        Background="{DynamicResource Surface0Brush}">
                                    <TextBlock Text="&#xE71D;" FontFamily="{StaticResource Ico}" FontSize="14"
                                               Foreground="{DynamicResource AccentBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="INVENTORY" Style="{StaticResource MetricEyebrow}"/>
                                    <TextBlock Text="{Binding ProgramCountText}" Style="{StaticResource MetricValue}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource MetricCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="38"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="32" Height="32" CornerRadius="6" VerticalAlignment="Center"
                                        Background="{DynamicResource Surface0Brush}">
                                    <TextBlock Text="&#xE74D;" FontFamily="{StaticResource Ico}" FontSize="14"
                                               Foreground="{DynamicResource PeachBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="POTENTIAL CLEANUP" Style="{StaticResource MetricEyebrow}"/>
                                    <TextBlock Text="{Binding TotalJunkDisplay}" Style="{StaticResource MetricValue}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Column="4" Style="{StaticResource MetricCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="38"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="32" Height="32" CornerRadius="6" VerticalAlignment="Center"
                                        Background="{DynamicResource Surface0Brush}">
                                    <TextBlock Text="&#xE72E;" FontFamily="{StaticResource Ico}" FontSize="14"
                                               Foreground="{DynamicResource GreenBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="DATA POSTURE" Style="{StaticResource MetricEyebrow}"/>
                                    <TextBlock Text="Local only" Style="{StaticResource MetricValue}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <DataGrid AutoGenerateColumns="False" x:Name="dgPrograms"
                               ItemsSource="{Binding FilteredPrograms}"
                               SelectionChanged="Programs_SelectionChanged"
                               MouseDoubleClick="Programs_DoubleClick"
                               Margin="0,96,0,0">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <Setter Property="ToolTip" Value="{Binding RemovalFactsDisplay}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRecentlyInstalled}" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                        <Setter Property="BorderThickness" Value="3,0,0,0"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Uninstall" Tag="&#xE74D;" Click="Uninstall_Click"
                                          IsEnabled="{Binding PlacementTarget.SelectedItem.CanUninstall, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <MenuItem Header="Uninstall Selected (bulk)" Tag="&#xE74D;" Click="BulkUninstall_Click"/>
                                <MenuItem Header="Scan Leftovers" Tag="&#xE721;" Click="ScanLeftovers_Click"/>
                                <MenuItem Header="Upgrade via winget" Tag="&#xE777;" Click="Ctx_WingetUpgrade_Click"/>
                                <Separator Style="{StaticResource MenuSep}"/>
                                <MenuItem Header="Open Install Folder" Tag="&#xE838;" Click="Ctx_OpenFolder_Click"/>
                                <MenuItem Header="Open in Registry" Tag="&#xE756;" Click="Ctx_OpenRegistry_Click"/>
                                <MenuItem Header="Copy Name" Tag="&#xE8C8;" Click="Ctx_CopyName_Click"/>
                                <Separator Style="{StaticResource MenuSep}"/>
                                <MenuItem Header="Check All" Tag="&#xE73A;" Click="Ctx_CheckAll_Click"/>
                                <MenuItem Header="Uncheck All" Tag="&#xE739;" Click="Ctx_UncheckAll_Click"/>
                                <MenuItem Header="Invert Selection" Tag="&#xE7C1;" Click="Ctx_InvertSelection_Click"/>
                                <Separator Style="{StaticResource MenuSep}"/>
                                <MenuItem Header="Copy All to Clipboard" Tag="&#xE8C8;" Command="{Binding CopyProgramsToClipboardCommand}"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="44"
                                                    HeaderTemplate="{StaticResource MasterCheckboxHeader}"/>
                            <DataGridTemplateColumn Header="PROGRAM" Width="*" MinWidth="220"
                                                    CellTemplate="{StaticResource IconNameCell}" SortMemberPath="DisplayName"/>
                            <DataGridTextColumn Binding="{Binding Publisher}" Header="PUBLISHER" Width="145"/>
                            <DataGridTextColumn Binding="{Binding DisplayVersion}" Header="VERSION" Width="96"/>
                            <DataGridTextColumn Binding="{Binding EstimatedSizeDisplay}" Header="SIZE" Width="90"/>
                            <DataGridTemplateColumn Header="SOURCE" Width="100" SortMemberPath="SourceDisplay">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource TableBadge}">
                                            <TextBlock Text="{Binding SourceDisplay}" FontSize="10.5"
                                                       Foreground="{DynamicResource SubtextBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Binding="{Binding CapabilityDisplay}" Header="CAPABILITY" Width="132"/>
                            <DataGridTextColumn Binding="{Binding RemovalStatus}" Header="ACTION" Width="178"/>
                            <DataGridTextColumn Binding="{Binding UninstallerRisk}" Header="RISK" Width="78"/>
                            <DataGridTextColumn Binding="{Binding UninstallerExecutablePath}" Header="ACTION EXE" Width="220"/>
                            <DataGridTemplateColumn Header="TRUST" Width="138" SortMemberPath="SignatureDisplay">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                    Visibility="{Binding SignatureDisplay, Converter={StaticResource BadgeVisConverter}}">
                                            <TextBlock Text="&#xEA18;" FontFamily="{StaticResource Ico}" FontSize="12"
                                                       Style="{StaticResource SignatureTone}" Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding SignatureDisplay}" FontSize="10.5"
                                                       Style="{StaticResource SignatureTone}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border Style="{StaticResource EmptyStateCard}" Panel.ZIndex="5" Margin="0,96,0,0"
                            AutomationProperties.Name="No installed programs shown">
                        <Border.Visibility>
                            <MultiBinding Converter="{StaticResource PanelEmptyStateVisConverter}" ConverterParameter="Programs">
                                <Binding Path="CurrentPanel"/>
                                <Binding Path="FilteredPrograms.Count"/>
                            </MultiBinding>
                        </Border.Visibility>
                        <StackPanel>
                            <TextBlock Text="&#xE721;" Style="{StaticResource EmptyStateIcon}"/>
                            <TextBlock Text="No programs match this view" Style="{StaticResource EmptyStateTitle}"/>
                            <TextBlock Text="Clear the search box or refresh the inventory to show installed programs again."
                                       Style="{StaticResource EmptyStateBody}"/>
                        </StackPanel>
                    </Border>

                    <!-- FORCED UNINSTALL -->
                    <Border x:Name="panelForced" Visibility="Collapsed">
                        <Border Padding="60,48" MaxWidth="560" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <StackPanel>
                                <Border Width="52" Height="52" CornerRadius="14" Margin="0,0,0,24" HorizontalAlignment="Left">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="{DynamicResource PeachColor}" Offset="0"/>
                                            <GradientStop Color="{DynamicResource RedColor}" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Border.Effect>
                                        <DropShadowEffect Color="{DynamicResource RedColor}" BlurRadius="18" ShadowDepth="0" Opacity="0.25"/>
                                    </Border.Effect>
                                    <TextBlock Text="&#xE71C;" FontFamily="{StaticResource Ico}" FontSize="22" Foreground="#FFFFFF"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Forced Uninstall" FontSize="24" FontWeight="Bold" Margin="0,0,0,8"
                                           Foreground="{DynamicResource TextBrush}"/>
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource SubtextBrush}"
                                           Margin="0,0,0,32" FontSize="13" LineHeight="21">
                                    Scan for remnants of programs that were partially removed or don't appear in the installed programs list.
                                </TextBlock>
                                <TextBlock Text="PROGRAM NAME" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Subtext0Brush}" Margin="2,0,0,8" Opacity="0.6"/>
                                <TextBox x:Name="txtForcedName" Margin="0,0,0,22"/>
                                <TextBlock Text="INSTALL FOLDER  (optional)" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Subtext0Brush}" Margin="2,0,0,8" Opacity="0.6"/>
                                <DockPanel Margin="0,0,0,32">
                                    <Button DockPanel.Dock="Right" Content="Browse" Click="BrowseFolder_Click" Margin="10,0,0,0" Padding="20,9"/>
                                    <TextBox x:Name="txtForcedPath"/>
                                </DockPanel>
                                <Button Content="Run Forced Scan" Style="{DynamicResource AccentButton}"
                                        Click="ForcedScan_Click" HorizontalAlignment="Left" Padding="32,11" FontSize="13"/>
                            </StackPanel>
                        </Border>
                    </Border>

                    <!-- WINDOWS APPS -->
                    <DataGrid AutoGenerateColumns="False" x:Name="dgWindowsApps" Visibility="Collapsed" ItemsSource="{Binding WindowsApps}">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Remove App" Tag="&#xE74D;" Click="RemoveWindowsApp_Click" Foreground="{DynamicResource RedBrush}"/>
                                <MenuItem Header="Copy App Name" Tag="&#xE8C8;" Click="Ctx_CopyName_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding DisplayName}" Header="APP NAME" Width="*" MinWidth="240"/>
                            <DataGridTextColumn Binding="{Binding Publisher}" Header="PUBLISHER" Width="180"/>
                            <DataGridTextColumn Binding="{Binding Version}" Header="VERSION" Width="115"/>
                            <DataGridTextColumn Binding="{Binding SizeDisplay}" Header="SIZE" Width="90"/>
                            <DataGridTextColumn Binding="{Binding Architecture}" Header="ARCH" Width="70"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- JUNK CLEANER (pre-loaded) -->
                    <DataGrid AutoGenerateColumns="False" x:Name="dgJunk" Visibility="Collapsed" ItemsSource="{Binding JunkCategories}">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Clean Selected" Tag="&#xE74D;" Click="CleanJunk_Click" Foreground="{DynamicResource RedBrush}"/>
