                                        <DataGridTextColumn Binding="{Binding Name}" Header="FOLDER" Width="*"/>
                                        <DataGridTextColumn Binding="{Binding SizeDisplay}" Header="SIZE" Width="115"/>
                                        <DataGridTextColumn Binding="{Binding FileCount}" Header="FILES" Width="85"/>
                                        <DataGridTextColumn Binding="{Binding FolderCount}" Header="FOLDERS" Width="85"/>
                                        <DataGridTextColumn Binding="{Binding PercentageDisplay}" Header="%" Width="75"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </TabItem>
                            <TabItem Header="Large Files">
                                <DataGrid AutoGenerateColumns="False" x:Name="dgLargeFiles" ItemsSource="{Binding LargeFiles}">
                                    <DataGrid.Columns>
                                        <DataGridCheckBoxColumn Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="44"
                                                                HeaderTemplate="{StaticResource MasterCheckboxHeader}"/>
                                        <DataGridTextColumn Binding="{Binding Name}" Header="FILE" Width="280"/>
                                        <DataGridTextColumn Binding="{Binding Path}" Header="PATH" Width="*"/>
                                        <DataGridTextColumn Binding="{Binding Extension}" Header="TYPE" Width="75"/>
                                        <DataGridTextColumn Binding="{Binding SizeDisplay}" Header="SIZE" Width="115"/>
                                        <DataGridTextColumn Binding="{Binding LastModifiedDisplay}" Header="MODIFIED" Width="105"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </TabItem>
                        </TabControl>
                    </Grid>

                    <!-- AUTORUN -->
                    <DataGrid AutoGenerateColumns="False" x:Name="dgAutorun" Visibility="Collapsed" ItemsSource="{Binding Autoruns}">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Toggle Enable/Disable" Tag="&#xE7B3;" Click="Ctx_ToggleAutorun_Click"/>
                                <MenuItem Header="Delete Entry" Tag="&#xE74D;" Click="DeleteAutorun_Click"
                                          IsEnabled="{Binding PlacementTarget.SelectedItem.MutationSupported, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          Foreground="{DynamicResource RedBrush}"/>
                                <Separator Style="{StaticResource MenuSep}"/>
                                <MenuItem Header="Open File Location" Tag="&#xE838;" Click="Ctx_OpenAutorunPath_Click"/>
                                <MenuItem Header="Copy Command" Tag="&#xE8C8;" Click="Ctx_CopyCommand_Click"/>
                                <Separator Style="{StaticResource MenuSep}"/>
                                <MenuItem Header="Copy All to Clipboard" Tag="&#xE8C8;" Command="{Binding CopyAutorunsToClipboardCommand}"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Binding="{Binding IsEnabled}" Header="ON" Width="54"/>
                            <DataGridTextColumn Binding="{Binding Name}" Header="NAME" Width="200"/>
                            <DataGridTextColumn Binding="{Binding Location}" Header="LOCATION" Width="150"/>
                            <DataGridTextColumn Binding="{Binding Command}" Header="COMMAND" Width="*"/>
                            <DataGridTextColumn Binding="{Binding Publisher}" Header="PUBLISHER" Width="130"/>
                            <DataGridTextColumn Binding="{Binding SignatureDisplay}" Header="SIGNATURE" Width="130"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- BROWSER EXT -->
                    <DataGrid AutoGenerateColumns="False" x:Name="dgBrowserExt" Visibility="Collapsed" ItemsSource="{Binding BrowserExtensions}">
                        <DataGrid.ContextMenu>
                            <ContextMenu DataContext="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource Self}}">
                                <MenuItem Header="Remove Extension" Tag="&#xE74D;" Click="RemoveBrowserExt_Click"
                                          Foreground="{DynamicResource RedBrush}"
                                          IsEnabled="{Binding IsRemovable}"
                                          ToolTip="{Binding RemovalReason}"/>
                                <MenuItem Header="Open Extension Folder" Tag="&#xE838;" Click="Ctx_OpenExtFolder_Click"/>
                                <MenuItem Header="Copy Extension Name" Tag="&#xE8C8;" Click="Ctx_CopyName_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding Name}" Header="EXTENSION" Width="*" MinWidth="180"/>
                            <DataGridTextColumn Binding="{Binding Browser}" Header="BROWSER" Width="120"/>
                            <DataGridTextColumn Binding="{Binding ProfileName}" Header="PROFILE" Width="90"/>
                            <DataGridTextColumn Binding="{Binding Version}" Header="VERSION" Width="85"/>
                            <DataGridTextColumn Binding="{Binding RiskDisplay}" Header="RISK" Width="70"/>
                            <DataGridTextColumn Binding="{Binding RiskLabelsDisplay}" Header="RISK LABELS" Width="200"/>
                            <DataGridTextColumn Binding="{Binding RemovalStatus}" Header="REMOVAL" Width="90"/>
                            <DataGridTextColumn Binding="{Binding SizeDisplay}" Header="SIZE" Width="75"/>
                            <DataGridTextColumn Binding="{Binding IsEnabled}" Header="ON" Width="48"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- CONTEXT MENU -->
                    <DataGrid AutoGenerateColumns="False" x:Name="dgContextMenu" Visibility="Collapsed" ItemsSource="{Binding ContextMenuEntries}">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Remove Orphaned" Tag="&#xE74D;" Click="RemoveContextMenu_Click" Foreground="{DynamicResource RedBrush}"/>
                                <MenuItem Header="Rescan" Tag="&#xE72C;" Click="ScanContextMenu_Click"/>
                                <Separator Style="{StaticResource MenuSep}"/>
                                <MenuItem Header="Check All" Tag="&#xE73A;" Click="Ctx_CheckAll_Click"/>
                                <MenuItem Header="Uncheck All" Tag="&#xE739;" Click="Ctx_UncheckAll_Click"/>
                                <MenuItem Header="Copy Entry Name" Tag="&#xE8C8;" Click="Ctx_CopyName_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="44"
                                                    HeaderTemplate="{StaticResource MasterCheckboxHeader}"/>
                            <DataGridTextColumn Binding="{Binding Name}" Header="ENTRY" Width="240"/>
                            <DataGridTextColumn Binding="{Binding Location}" Header="LOCATION" Width="180"/>
                            <DataGridTextColumn Binding="{Binding Command}" Header="COMMAND" Width="*"/>
                            <DataGridTextColumn Binding="{Binding Status}" Header="STATUS" Width="95"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- SERVICES -->
                    <DataGrid AutoGenerateColumns="False" x:Name="dgServices" Visibility="Collapsed" ItemsSource="{Binding Services}">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Disable Service" Tag="&#xE769;" Click="DisableService_Click"
                                          IsEnabled="{Binding PlacementTarget.SelectedItem.MutationSupported, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <MenuItem Header="Delete Service" Tag="&#xE74D;" Click="DeleteService_Click"
                                          IsEnabled="{Binding PlacementTarget.SelectedItem.DeletionSupported, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          Visibility="{Binding PlacementTarget.DataContext.ExpertMode, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVis}}"
                                          Foreground="{DynamicResource RedBrush}"/>
                                <Separator Style="{StaticResource MenuSep}"/>
                                <MenuItem Header="Open in services.msc" Tag="&#xE912;" Click="Ctx_OpenServicesMsc_Click"/>
                                <MenuItem Header="Copy Service Name" Tag="&#xE8C8;" Click="Ctx_CopyName_Click"/>
                                <MenuItem Header="Rescan" Tag="&#xE72C;" Click="ScanServices_Click"/>
                                <Separator Style="{StaticResource MenuSep}"/>
                                <MenuItem Header="Check All" Tag="&#xE73A;" Click="Ctx_CheckAll_Click"/>
                                <MenuItem Header="Uncheck All" Tag="&#xE739;" Click="Ctx_UncheckAll_Click"/>
                                <Separator Style="{StaticResource MenuSep}"/>
                                <MenuItem Header="Copy All to Clipboard" Tag="&#xE8C8;" Command="{Binding CopyServicesToClipboardCommand}"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="44"
                                                    HeaderTemplate="{StaticResource MasterCheckboxHeader}"/>
                            <DataGridTextColumn Binding="{Binding DisplayName}" Header="SERVICE" Width="*" MinWidth="200"/>
                            <DataGridTextColumn Binding="{Binding Name}" Header="NAME" Width="170"/>
                            <DataGridTextColumn Binding="{Binding StartType}" Header="STARTUP" Width="90"/>
                            <DataGridTextColumn Binding="{Binding StatusDisplay}" Header="STATUS" Width="90"/>
                            <DataGridTextColumn Binding="{Binding SignatureDisplay}" Header="SIGNATURE" Width="130"/>
                            <DataGridTextColumn Binding="{Binding ImagePath}" Header="PATH" Width="210"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- TASKS (pre-loaded) -->
                    <DataGrid AutoGenerateColumns="False" x:Name="dgTasks" Visibility="Collapsed" ItemsSource="{Binding ScheduledTasks}">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Delete Task" Tag="&#xE74D;" Click="DeleteTask_Click"
                                          IsEnabled="{Binding PlacementTarget.SelectedItem.MutationSupported, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          Foreground="{DynamicResource RedBrush}"/>
                                <MenuItem Header="Open Task Scheduler" Tag="&#xE823;" Click="Ctx_OpenTaskScheduler_Click"/>
                                <MenuItem Header="Copy Task Name" Tag="&#xE8C8;" Click="Ctx_CopyName_Click"/>
                                <MenuItem Header="Rescan" Tag="&#xE72C;" Click="ScanTasks_Click"/>
                                <Separator Style="{StaticResource MenuSep}"/>
                                <MenuItem Header="Check All" Tag="&#xE73A;" Click="Ctx_CheckAll_Click"/>
                                <MenuItem Header="Uncheck All" Tag="&#xE739;" Click="Ctx_UncheckAll_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="44"
                                                    HeaderTemplate="{StaticResource MasterCheckboxHeader}"/>
                            <DataGridTextColumn Binding="{Binding Name}" Header="TASK" Width="260"/>
                            <DataGridTextColumn Binding="{Binding Author}" Header="AUTHOR" Width="160"/>
                            <DataGridTextColumn Binding="{Binding Action}" Header="ACTION" Width="*"/>
                            <DataGridTextColumn Binding="{Binding Status}" Header="STATUS" Width="95"/>
                            <DataGridTextColumn Binding="{Binding LastRunTime}" Header="LAST RUN" Width="135"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- RESTORE -->
                    <DataGrid AutoGenerateColumns="False" x:Name="dgRestore" Visibility="Collapsed" ItemsSource="{Binding RestorePoints}">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Create New Restore Point" Tag="&#xE710;" Click="CreateRestorePoint_Click"/>
                                <MenuItem Header="Copy Description" Tag="&#xE8C8;" Click="Ctx_CopyName_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="44"
                                                    HeaderTemplate="{StaticResource MasterCheckboxHeader}"/>
                            <DataGridTextColumn Binding="{Binding Description}" Header="DESCRIPTION" Width="*"/>
                            <DataGridTextColumn Binding="{Binding Type}" Header="TYPE" Width="170"/>
                            <DataGridTextColumn Binding="{Binding CreationTimeDisplay}" Header="CREATED" Width="150"/>
                            <DataGridTextColumn Binding="{Binding AgeDisplay}" Header="AGE" Width="95"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- REGISTRY HUNTER (parallel across HKLM/HKCU/HKCR roots) -->
                    <Grid x:Name="panelHunter" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Query row -->
                        <Border Grid.Row="0" Padding="24,16,24,8">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Search" Click="RegistryHunt_Click"
                                        Style="{DynamicResource AccentButton}" Margin="10,0,0,0" Padding="22,8"/>
                                <TextBox x:Name="txtHunter" KeyDown="HunterInput_KeyDown"
                                         ToolTip="Search all of HKLM / HKCU / HKCR / WOW6432Node in parallel (3+ chars)"/>
                            </DockPanel>
                        </Border>

                        <!-- Scope + regex toggles -->
                        <Border Grid.Row="1" Padding="24,4,24,14">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Match in:" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Subtext0Brush}" FontSize="11"
                                           Margin="0,0,10,0"/>
                                <CheckBox IsChecked="{Binding HunterSearchKeys}" VerticalAlignment="Center" Margin="0,0,14,0">
                                    <TextBlock Text="Keys" Margin="6,0,0,0" FontSize="11"/>
                                </CheckBox>
                                <CheckBox IsChecked="{Binding HunterSearchNames}" VerticalAlignment="Center" Margin="0,0,14,0">
                                    <TextBlock Text="Value names" Margin="6,0,0,0" FontSize="11"/>
                                </CheckBox>
                                <CheckBox IsChecked="{Binding HunterSearchData}" VerticalAlignment="Center" Margin="0,0,24,0">
                                    <TextBlock Text="Value data" Margin="6,0,0,0" FontSize="11"/>
                                </CheckBox>
                                <CheckBox IsChecked="{Binding HunterUseRegex}" VerticalAlignment="Center" Margin="0,0,24,0">
                                    <TextBlock Text="Regex" Margin="6,0,0,0" FontSize="11"
                                               Foreground="{DynamicResource MauveBrush}"/>
                                </CheckBox>
                                <TextBlock Text="{Binding HunterLiveCount, StringFormat={}{0} hits}"
                                           VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentBrush}"/>
                            </StackPanel>
                        </Border>

                        <DataGrid Grid.Row="2" x:Name="dgHunter" AutoGenerateColumns="False"
                                  ItemsSource="{Binding RegistryHits}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Binding="{Binding Path}" Header="PATH" Width="*"/>
                                <DataGridTextColumn Binding="{Binding ValueName}" Header="VALUE" Width="180"/>
                                <DataGridTextColumn Binding="{Binding ValueData}" Header="DATA" Width="300"/>
                                <DataGridTextColumn Binding="{Binding Match}" Header="MATCH" Width="95"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                    <!-- ORPHANED ARTIFACTS (unified panel) -->
                    <Grid x:Name="panelOrphans" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Padding="24,16,24,8">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Scan" Click="OrphanScan_Click"
                                        Style="{DynamicResource AccentButton}" Margin="10,0,0,0" Padding="22,8"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Orphaned Artifacts" FontSize="18" FontWeight="Bold"
                                               Foreground="{DynamicResource TextBrush}"/>
                                    <TextBlock Text="{Binding OrphanSummary}" FontSize="11"
                                               Foreground="{DynamicResource SubtextBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,8,24,16">
                            <StackPanel>
                                <!-- Firewall Rules -->
                                <TextBlock Text="ORPHANED FIREWALL RULES" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Subtext0Brush}" Margin="0,8,0,6"/>
                                <DataGrid AutoGenerateColumns="False" HeadersVisibility="Column"
                                          ItemsSource="{Binding OrphanedFirewallRules}"
                                          MaxHeight="280" IsReadOnly="False">
                                    <DataGrid.Columns>
                                        <DataGridCheckBoxColumn Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="36"
                                                                HeaderTemplate="{StaticResource MasterCheckboxHeader}"/>
                                        <DataGridTextColumn Binding="{Binding DisplayName}" Header="RULE" Width="*" IsReadOnly="True"/>
                                        <DataGridTextColumn Binding="{Binding Program}" Header="PROGRAM" Width="280" IsReadOnly="True"/>
                                        <DataGridTextColumn Binding="{Binding Direction}" Header="DIR" Width="60" IsReadOnly="True"/>
                                        <DataGridTextColumn Binding="{Binding Action}" Header="ACTION" Width="65" IsReadOnly="True"/>
                                        <DataGridTextColumn Binding="{Binding Status}" Header="STATUS" Width="80" IsReadOnly="True"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <Button Content="Delete Selected Firewall Rules" Click="DeleteOrphanedFirewallRules_Click"
                                        Style="{DynamicResource AccentButton}" HorizontalAlignment="Left"
                                        Padding="16,6" Margin="0,8,0,16"/>

                                <!-- PATH Entries -->
                                <TextBlock Text="ORPHANED PATH ENTRIES" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Subtext0Brush}" Margin="0,8,0,6"/>
                                <DataGrid AutoGenerateColumns="False" HeadersVisibility="Column"
                                          ItemsSource="{Binding OrphanedPathEntries}"
                                          MaxHeight="240" IsReadOnly="False">
                                    <DataGrid.Columns>
                                        <DataGridCheckBoxColumn Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="36"
                                                                HeaderTemplate="{StaticResource MasterCheckboxHeader}"/>
                                        <DataGridTextColumn Binding="{Binding Directory}" Header="DIRECTORY" Width="*" IsReadOnly="True"/>
                                        <DataGridTextColumn Binding="{Binding Source}" Header="SCOPE" Width="70" IsReadOnly="True"/>
                                        <DataGridTextColumn Binding="{Binding Status}" Header="STATUS" Width="80" IsReadOnly="True"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <Button Content="Remove Selected PATH Entries" Click="RemoveOrphanedPathEntries_Click"
                                        Style="{DynamicResource AccentButton}" HorizontalAlignment="Left"
                                        Padding="16,6" Margin="0,8,0,16"/>

                                <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource Subtext0Brush}" Margin="0,8,0,0"
                                           Text="Orphaned services and scheduled tasks are already shown in their respective panels above. This panel adds firewall rules and PATH entries that reference deleted programs."/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- BACKUPS -->
                    <Grid x:Name="panelDeletionRecovery" Visibility="Collapsed"
                          AutomationProperties.Name="Deletion Recovery panel"
                          AutomationProperties.HelpText="Lists deletion manifests, previews rollback entries, and runs dry-run restore checks.">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="220"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="150"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Padding="24,16,24,8">
                            <StackPanel>
                                <TextBlock Text="Deletion Manifest Recovery" FontSize="18" FontWeight="Bold"
                                           Foreground="{DynamicResource TextBrush}"/>
                                <TextBlock Text="{Binding DeletionManifestSummary}" TextWrapping="Wrap"
                                           FontSize="12" Foreground="{DynamicResource SubtextBrush}" Margin="0,4,0,0"/>
                                <TextBlock Text="{Binding DeletionRestoreSummary}" TextWrapping="Wrap"
                                           FontSize="12" Foreground="{DynamicResource TextBrush}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <DataGrid Grid.Row="1" Margin="24,8,24,8" AutoGenerateColumns="False"
                                  ItemsSource="{Binding DeletionManifests}"
                                  SelectedItem="{Binding SelectedDeletionManifest, Mode=TwoWay}"
                                  IsReadOnly="True" HeadersVisibility="Column"
                                  AutomationProperties.Name="Deletion manifests">
                            <DataGrid.Columns>
                                <DataGridTextColumn Binding="{Binding Date, StringFormat={}{0:yyyy-MM-dd}}" Header="DATE" Width="110"/>
                                <DataGridTextColumn Binding="{Binding EntryCount}" Header="ENTRIES" Width="80"/>
                                <DataGridTextColumn Binding="{Binding TotalBytes, Converter={StaticResource BytesToSizeConverter}}" Header="BYTES" Width="100"/>
                                <DataGridTextColumn Binding="{Binding FilePath}" Header="MANIFEST" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border Grid.Row="1" Style="{StaticResource EmptyStateCard}"
                                Visibility="{Binding DeletionManifests, Converter={StaticResource EmptyCollectionVisConverter}}"
                                AutomationProperties.Name="No deletion manifests available">
                            <StackPanel>
                                <TextBlock Text="&#xE8BB;" Style="{StaticResource EmptyStateIcon}"/>
                                <TextBlock Text="No deletion manifests yet" Style="{StaticResource EmptyStateTitle}"/>
                                <TextBlock Text="Cleanup and restore-safe delete operations will appear here once they record rollback data."
                                           Style="{StaticResource EmptyStateBody}"/>
                            </StackPanel>
                        </Border>

                        <UniformGrid Grid.Row="2" Columns="3" Margin="24,0,24,8">
                            <Border Padding="12,10" Margin="0,0,8,0" Background="{DynamicResource MantleBrush}" CornerRadius="8">
                                <TextBlock Text="{Binding DeletionRegistryRestored, StringFormat=Registry restores: {0}}"
                                           Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold"/>
                            </Border>
                            <Border Padding="12,10" Margin="4,0,4,0" Background="{DynamicResource MantleBrush}" CornerRadius="8">
                                <TextBlock Text="{Binding DeletionFilesRecoverable, StringFormat=Recycle Bin candidates: {0}}"
                                           Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold"/>
                            </Border>
                            <Border Padding="12,10" Margin="8,0,0,0" Background="{DynamicResource MantleBrush}" CornerRadius="8">
                                <TextBlock Text="{Binding DeletionUnrecoverable, StringFormat=Unrecoverable: {0}}"
                                           Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold"/>
                            </Border>
                        </UniformGrid>

                        <DataGrid Grid.Row="3" Margin="24,0,24,8" AutoGenerateColumns="False"
                                  ItemsSource="{Binding DeletionManifestEntries}"
                                  IsReadOnly="True" HeadersVisibility="Column"
                                  AutomationProperties.Name="Deletion manifest entries">
                            <DataGrid.Columns>
                                <DataGridTextColumn Binding="{Binding TimestampUtc, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Header="TIME (UTC)" Width="140"/>
                                <DataGridTextColumn Binding="{Binding Type}" Header="TYPE" Width="90"/>
                                <DataGridTextColumn Binding="{Binding Operation}" Header="OPERATION" Width="150"/>
                                <DataGridTextColumn Binding="{Binding Outcome}" Header="OUTCOME" Width="100"/>
                                <DataGridTextColumn Binding="{Binding SizeBytes, Converter={StaticResource BytesToSizeConverter}}" Header="SIZE" Width="90"/>
                                <DataGridTextColumn Binding="{Binding Path}" Header="PATH" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <ListBox Grid.Row="4" Margin="24,0,24,16" ItemsSource="{Binding DeletionRestoreDetails}"
                                 Background="{DynamicResource MantleBrush}" BorderThickness="0"
                                 AutomationProperties.Name="Deletion restore dry-run details">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap"
                                               FontSize="12" Foreground="{DynamicResource SubtextBrush}"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Border Grid.Row="4" Style="{StaticResource EmptyStateCard}" Padding="18" MaxWidth="460"
                                Visibility="{Binding DeletionRestoreDetails, Converter={StaticResource EmptyCollectionVisConverter}}"
                                AutomationProperties.Name="No restore dry-run details">
                            <StackPanel>
                                <TextBlock Text="Dry-run restore details will appear here before any restore is applied."
                                           Style="{StaticResource EmptyStateBody}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border x:Name="panelBackups" Visibility="Collapsed" Padding="48,32">
                        <StackPanel MaxWidth="560" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <TextBlock Text="Registry Backups" FontSize="24" FontWeight="Bold"
                                       Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8"/>
                            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource SubtextBrush}"
                                       Margin="0,0,0,24" FontSize="13" LineHeight="21">
                                Every destructive registry operation creates a SHA-256-bound <Run FontWeight="SemiBold">.reg</Run>
                                rollback artifact in protected system storage. Restore through Deletion Recovery so scope,
                                ownership, DACL, operation identity, and content are validated before import.
                            </TextBlock>
                            <Button Content="Open Backup Folder" Click="OpenBackupFolder_Click"
                                    Style="{DynamicResource AccentButton}" HorizontalAlignment="Left" Padding="28,10"/>
                        </StackPanel>
                    </Border>

                    <!-- ═══════════════════════════════════════════════════════ -->
                    <!-- DRIVER STORE (pnputil /enum-drivers + size + old-version flag)  -->
                    <!-- ═══════════════════════════════════════════════════════ -->
                    <DataGrid x:Name="dgDrivers" Visibility="Collapsed" AutoGenerateColumns="False"
                              ItemsSource="{Binding DriverPackages}"
                              AutomationProperties.Name="Driver Store packages"
                              AutomationProperties.HelpText="Third-party driver packages. A selected package is exported and hashed before removal; protected packages remain pinned and verified backups can be rolled back.">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Copy All to Clipboard" Tag="&#xE8C8;" Command="{Binding CopyDriversToClipboardCommand}"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding PublishedName}" Header="OEM" Width="90"/>
                            <DataGridTextColumn Binding="{Binding OriginalName}" Header="INF" Width="220"/>
                            <DataGridTextColumn Binding="{Binding ProviderName}" Header="PROVIDER" Width="170"/>
                            <DataGridTextColumn Binding="{Binding ClassName}" Header="CLASS" Width="140"/>
                            <DataGridTextColumn Binding="{Binding DriverVersion}" Header="VERSION / DATE" Width="220"/>
                            <DataGridTextColumn Binding="{Binding SizeBytes, Converter={StaticResource BytesToSizeConverter}}" Header="SIZE" Width="90"/>
                            <DataGridTextColumn Binding="{Binding IsOldVersion, Converter={StaticResource BoolToOldBadgeConverter}}" Header="STATUS" Width="80"/>
                            <DataGridTextColumn Binding="{Binding SafetyStatus}" Header="SAFETY" Width="110"/>
                            <DataGridTextColumn Binding="{Binding RollbackStatus}" Header="ROLLBACK" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border Style="{StaticResource EmptyStateCard}" Panel.ZIndex="5"
                            AutomationProperties.Name="No driver packages found">
                        <Border.Visibility>
                            <MultiBinding Converter="{StaticResource PanelEmptyStateVisConverter}" ConverterParameter="Drivers">
                                <Binding Path="CurrentPanel"/>
                                <Binding Path="DriverPackages.Count"/>
                            </MultiBinding>
                        </Border.Visibility>
                        <StackPanel>
                            <TextBlock Text="&#xE95B;" Style="{StaticResource EmptyStateIcon}"/>
                            <TextBlock Text="No removable driver packages found" Style="{StaticResource EmptyStateTitle}"/>
                            <TextBlock Text="Run a rescan after driver updates. DeepPurge only lists third-party packages it can inspect safely."
                                       Style="{StaticResource EmptyStateBody}"/>
                        </StackPanel>
                    </Border>

                    <!-- ═══════════════════════════════════════════════════════ -->
                    <!-- STARTUP IMPACT (parsed from WDI boot traces)            -->
                    <!-- ═══════════════════════════════════════════════════════ -->
                    <DataGrid x:Name="dgStartupImpact" Visibility="Collapsed" AutoGenerateColumns="False"
                              ItemsSource="{Binding StartupImpacts}"
                              AutomationProperties.Name="Startup impact analysis"
                              AutomationProperties.HelpText="Boot-time cost per autorun process. High-impact processes slow system startup.">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Copy All to Clipboard" Tag="&#xE8C8;" Command="{Binding CopyStartupImpactToClipboardCommand}"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding Impact}" Header="IMPACT" Width="90"/>
                            <DataGridTextColumn Binding="{Binding ProcessName}" Header="PROCESS" Width="280"/>
                            <DataGridTextColumn Binding="{Binding DiskBytes, Converter={StaticResource BytesToSizeConverter}}" Header="DISK" Width="90"/>
                            <DataGridTextColumn Binding="{Binding CpuMs, StringFormat={}{0} ms}" Header="CPU" Width="90"/>
                            <DataGridTextColumn Binding="{Binding CommandLine}" Header="COMMAND" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border Style="{StaticResource EmptyStateCard}" Panel.ZIndex="5"
                            AutomationProperties.Name="No startup impact data found">
                        <Border.Visibility>
                            <MultiBinding Converter="{StaticResource PanelEmptyStateVisConverter}" ConverterParameter="StartupImpact">
                                <Binding Path="CurrentPanel"/>
                                <Binding Path="StartupImpacts.Count"/>
                            </MultiBinding>
                        </Border.Visibility>
                        <StackPanel>
                            <TextBlock Text="&#xE7F4;" Style="{StaticResource EmptyStateIcon}"/>
                            <TextBlock Text="No startup impact data is available" Style="{StaticResource EmptyStateTitle}"/>
                            <TextBlock Text="Windows only records this data after boot traces are present. Refresh after the next restart."
                                       Style="{StaticResource EmptyStateBody}"/>
                        </StackPanel>
                    </Border>

                    <!-- ═══════════════════════════════════════════════════════ -->
                    <!-- BROKEN SHORTCUTS (.lnk on Desktop + Start Menu)         -->
                    <!-- ═══════════════════════════════════════════════════════ -->
                    <DataGrid x:Name="dgShortcuts" Visibility="Collapsed" AutoGenerateColumns="False"
                              ItemsSource="{Binding BrokenShortcuts}"
                              AutomationProperties.Name="Broken shortcuts"
                              AutomationProperties.HelpText="Desktop and Start Menu shortcuts pointing to missing targets.">
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding Path}" Header="SHORTCUT" Width="2*"/>
                            <DataGridTextColumn Binding="{Binding TargetPath}" Header="MISSING TARGET" Width="2*"/>
                            <DataGridTextColumn Binding="{Binding Description}" Header="DESCRIPTION" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border Style="{StaticResource EmptyStateCard}" Panel.ZIndex="5"
                            AutomationProperties.Name="No broken shortcuts found">
                        <Border.Visibility>
                            <MultiBinding Converter="{StaticResource PanelEmptyStateVisConverter}" ConverterParameter="Shortcuts">
                                <Binding Path="CurrentPanel"/>
                                <Binding Path="BrokenShortcuts.Count"/>
                            </MultiBinding>
                        </Border.Visibility>
                        <StackPanel>
                            <TextBlock Text="&#xE73E;" Style="{StaticResource EmptyStateIcon}"/>
                            <TextBlock Text="No broken shortcuts found" Style="{StaticResource EmptyStateTitle}"/>
                            <TextBlock Text="Desktop and Start Menu shortcuts currently point to existing targets."
                                       Style="{StaticResource EmptyStateBody}"/>
                        </StackPanel>
                    </Border>

                    <!-- ═══════════════════════════════════════════════════════ -->
                    <!-- DUPLICATE FILES (size → XXH3 head → XXH3 full)          -->
                    <!-- ═══════════════════════════════════════════════════════ -->
                    <DataGrid x:Name="dgDuplicates" Visibility="Collapsed" AutoGenerateColumns="False"
                              ItemsSource="{Binding DuplicateGroups}"
                              AutomationProperties.Name="Duplicate file groups"
                              AutomationProperties.HelpText="Files with identical content grouped by hash. Select one retained keeper in each group before deleting copies.">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Copy All to Clipboard" Tag="&#xE8C8;" Command="{Binding CopyDuplicatesToClipboardCommand}"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding FileSize, Converter={StaticResource BytesToSizeConverter}}" Header="SIZE" Width="90"/>
                            <DataGridTextColumn Binding="{Binding Paths, Converter={StaticResource CountConverter}}" Header="COPIES" Width="70"/>
                            <DataGridTextColumn Binding="{Binding WastedBytes, Converter={StaticResource BytesToSizeConverter}}" Header="WASTED" Width="100"/>
                            <DataGridTemplateColumn Header="KEEPER" Width="2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding KeeperOptions}"
                                                  SelectedItem="{Binding KeeperPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  ToolTip="Select the copy to retain."
                                                  AutomationProperties.Name="Retained duplicate copy"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="PATHS" Width="*">
                                <DataGridTextColumn.Binding>
                                    <Binding Path="Paths" Converter="{StaticResource PathListJoinConverter}"/>
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border Style="{StaticResource EmptyStateCard}" Panel.ZIndex="5"
                            AutomationProperties.Name="Duplicate scan has no results">
                        <Border.Visibility>
                            <MultiBinding Converter="{StaticResource PanelEmptyStateVisConverter}" ConverterParameter="Duplicates">
                                <Binding Path="CurrentPanel"/>
                                <Binding Path="DuplicateGroups.Count"/>
                            </MultiBinding>
                        </Border.Visibility>
                        <StackPanel>
                            <TextBlock Text="&#xE8C8;" Style="{StaticResource EmptyStateIcon}"/>
                            <TextBlock Text="Scan your profile to find duplicates" Style="{StaticResource EmptyStateTitle}"/>
                            <TextBlock Text="DeepPurge compares file size, fast hash, and full hash before grouping safe duplicate candidates."
                                       Style="{StaticResource EmptyStateBody}"/>
                        </StackPanel>
                    </Border>

                    <!-- ═══════════════════════════════════════════════════════ -->
                    <!-- COMMUNITY CLEANERS (winapp2.ini)                        -->
                    <!-- ═══════════════════════════════════════════════════════ -->
                    <Grid x:Name="panelWinapp2" Visibility="Collapsed"
                          AutomationProperties.Name="Community Cleaners panel"
                          AutomationProperties.HelpText="Winapp2.ini community-maintained cleaner definitions. Run applicable rules to clean third-party app caches.">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="180"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Padding="24,14" Background="{DynamicResource MantleBrush}">
                            <StackPanel>
                                <TextBlock FontSize="12" Foreground="{DynamicResource SubtextBrush}"
                                           Text="{Binding Winapp2Source, StringFormat=winapp2 source: {0}}"/>
                                <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource TextBrush}"
                                           Text="{Binding CleanerValidationSummary}"/>
                                <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource SubtextBrush}"
                                           Text="{Binding CleanerUpdateDiff, StringFormat=last update target diff: {0}}"/>
                            </StackPanel>
                        </Border>
                        <DataGrid Grid.Row="1" AutoGenerateColumns="False" ItemsSource="{Binding CleanerValidationReports}"
                                  AutomationProperties.Name="Custom JSON cleaner validation results">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Binding="{Binding FileName}" Header="FILE" Width="160"/>
                                    <DataGridTextColumn Binding="{Binding SchemaDisplay}" Header="SCHEMA" Width="100"/>
                                    <DataGridTextColumn Binding="{Binding Status}" Header="STATUS" Width="80"/>
                                    <DataGridTextColumn Binding="{Binding RiskLabel}" Header="RISK" Width="80"/>
                                    <DataGridTextColumn Binding="{Binding TrustDisplay}" Header="TRUST" Width="120"/>
                                    <DataGridTextColumn Binding="{Binding HashDisplay}" Header="SHA256" Width="110"/>
                                    <DataGridTextColumn Binding="{Binding ProvenanceDisplay}" Header="PROVENANCE" Width="150"/>
                                <DataGridTextColumn Binding="{Binding EstimatedItems}" Header="ITEMS" Width="70"/>
                                <DataGridTextColumn Binding="{Binding EstimatedBytes, Converter={StaticResource BytesToSizeConverter}}" Header="BYTES" Width="90"/>
                                <DataGridTextColumn Binding="{Binding RegistryScopesDisplay}" Header="REGISTRY" Width="120"/>
                                <DataGridTextColumn Binding="{Binding ExpandedTargetsDisplay}" Header="TARGETS" Width="2*"/>
                                <DataGridTextColumn Binding="{Binding IssuesDisplay}" Header="ISSUES" Width="2*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <DataGrid Grid.Row="2" AutoGenerateColumns="False" ItemsSource="{Binding Winapp2Entries}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Binding="{Binding Section}" Header="ENTRY" Width="2*"/>
                                <DataGridTextColumn Binding="{Binding LangSecRef}" Header="CATEGORY" Width="100"/>
                                <DataGridTextColumn Binding="{Binding DetectOS}" Header="OS GATE" Width="120"/>
                                <DataGridTextColumn Binding="{Binding FileKeys, Converter={StaticResource CountConverter}}" Header="FILES" Width="70"/>
                                <DataGridTextColumn Binding="{Binding RegKeys, Converter={StaticResource CountConverter}}"  Header="REG" Width="70"/>
                                <DataGridTextColumn Binding="{Binding Warning, Converter={StaticResource FirstOrEmptyConverter}}" Header="WARNING" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border Grid.Row="2" Style="{StaticResource EmptyStateCard}"
                                Visibility="{Binding Winapp2Entries, Converter={StaticResource EmptyCollectionVisConverter}}"
                                AutomationProperties.Name="No applicable community cleaners">
                            <StackPanel>
                                <TextBlock Text="&#xE8A5;" Style="{StaticResource EmptyStateIcon}"/>
                                <TextBlock Text="No applicable community cleaners loaded" Style="{StaticResource EmptyStateTitle}"/>
                                <TextBlock Text="Load or refresh winapp2.ini. Cleaners are shown only when their detection rules match this PC."
                                           Style="{StaticResource EmptyStateBody}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- ═══════════════════════════════════════════════════════ -->
                    <!-- REPAIR WINDOWS (sfc / dism / chkdsk / caches)           -->
                    <!-- ═══════════════════════════════════════════════════════ -->
                    <Grid x:Name="panelRepair" Visibility="Collapsed"
                          AutomationProperties.Name="Windows Repair tools"
                          AutomationProperties.HelpText="System integrity and cache rebuild tools. sfc, DISM, chkdsk, font cache, and icon cache.">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Padding="24,16,24,8">
                            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource SubtextBrush}" FontSize="12.5" LineHeight="20">
                                Integrity and cache-rebuild tools that wrap Microsoft utilities. Each command streams its
                                output below. Long runs (DISM, chkdsk) can take several minutes — leave the window open.
                            </TextBlock>
                        </Border>
                        <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="24,4,24,14">
                            <Button Content="sfc /scannow"              Command="{Binding RunSfcCommand}"            Style="{DynamicResource AccentButton}" Margin="0,0,8,6" Padding="14,8"
                                    AutomationProperties.Name="Run System File Checker scan"/>
                            <Button Content="DISM ScanHealth"           Command="{Binding RunDismScanCommand}"       Margin="0,0,8,6" Padding="14,8"
                                    AutomationProperties.Name="Run DISM scan health check"/>
                            <Button Content="DISM RestoreHealth"        Command="{Binding RunDismRestoreCommand}"    Margin="0,0,8,6" Padding="14,8"/>
                            <Button Content="DISM ComponentCleanup"     Command="{Binding RunDismCleanupCommand}"    Margin="0,0,8,6" Padding="14,8"/>
                            <Button Content="chkdsk C: /scan"           Command="{Binding RunChkDskCommand}"         Margin="0,0,8,6" Padding="14,8"/>
                            <Button Content="Rebuild Font Cache"        Command="{Binding RebuildFontCacheCommand}"  Margin="0,0,8,6" Padding="14,8"/>
                            <Button Content="Rebuild Icon Cache"        Command="{Binding RebuildIconCacheCommand}"  Margin="0,0,8,6" Padding="14,8"/>
                        </WrapPanel>
                        <Border Grid.Row="2" Margin="24,0,24,16" Padding="14" Background="{DynamicResource MantleBrush}" CornerRadius="8">
                            <Grid>
                                <TextBox x:Name="txtRepairOutput"
                                         Text="{Binding RepairOutput, Mode=OneWay}"
                                         IsReadOnly="True" BorderThickness="0"
                                         Background="Transparent" Foreground="{DynamicResource TextBrush}"
                                         FontFamily="Consolas,Cascadia Code" FontSize="12"
                                         TextWrapping="NoWrap" AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                         TextChanged="RepairOutput_TextChanged"/>
                                <Border Style="{StaticResource EmptyStateCard}" Padding="18" MaxWidth="480"
                                        Visibility="{Binding RepairOutput, Converter={StaticResource EmptyCollectionVisConverter}}"
                                        AutomationProperties.Name="No repair command output yet">
                                    <StackPanel>
                                        <TextBlock Text="Choose a repair command to stream output here" Style="{StaticResource EmptyStateTitle}"/>
                                        <TextBlock Text="The output panel stays inside DeepPurge so long-running system tools do not open separate consoles."
                                                   Style="{StaticResource EmptyStateBody}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ═══════════════════════════════════════════════════════ -->
                    <!-- SCHEDULED CLEANING (Task Scheduler 2.0 exec actions)    -->
                    <!-- ═══════════════════════════════════════════════════════ -->
                    <Grid x:Name="panelSchedule" Visibility="Collapsed"
                          AutomationProperties.Name="Scheduled Cleaning panel"
                          AutomationProperties.HelpText="Scheduled cleaning jobs running via Task Scheduler with constrained DeepPurge presets.">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Padding="24,16">
                            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource SubtextBrush}" FontSize="12.5" LineHeight="20">
                                Scheduled jobs run a content-addressed DeepPurgeCli copy from an administrator-owned ProgramData folder.
                                Task definitions in <Run FontWeight="SemiBold">\DeepPurge\</Run> separate executable and arguments, use constrained presets,
                                and expose their principal, action, and protection status below.
                            </TextBlock>
                        </Border>
                        <GroupBox Grid.Row="1" Header="Create constrained job" Margin="24,0,24,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.25*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="1.15*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="0.8*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="0.75*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Job name" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}" Margin="0,0,0,6"/>
                                    <TextBox x:Name="txtScheduleName" Text="Weekly DeepPurge Cleanup"
                                             AutomationProperties.Name="Scheduled job name"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Preset" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}" Margin="0,0,0,6"/>
                                    <ComboBox x:Name="cmbSchedulePreset" SelectedIndex="0"
                                              AutomationProperties.Name="Scheduled cleaning preset">
                                        <ComboBoxItem Content="Safe cleanup: junk + evidence" Tag="clean junk evidence"/>
                                        <ComboBoxItem Content="Dry-run preview: junk + evidence" Tag="clean junk evidence --dry-run"/>
                                        <ComboBoxItem Content="Junk only" Tag="clean junk"/>
                                        <ComboBoxItem Content="Evidence only" Tag="clean evidence"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Frequency" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}" Margin="0,0,0,6"/>
                                    <ComboBox x:Name="cmbScheduleFrequency" SelectedIndex="1"
                                              AutomationProperties.Name="Scheduled job frequency">
                                        <ComboBoxItem Content="Daily" Tag="Daily"/>
                                        <ComboBoxItem Content="Weekly" Tag="Weekly"/>
                                        <ComboBoxItem Content="Monthly" Tag="Monthly"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="6">
                                    <TextBlock Text="Time" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}" Margin="0,0,0,6"/>
                                    <TextBox x:Name="txtScheduleTime" Text="03:00"
                                             AutomationProperties.Name="Scheduled job start time"/>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="7" Margin="0,14,0,0">
                                    <TextBlock Text="Weekly day" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}" Margin="0,0,0,6"/>
                                    <ComboBox x:Name="cmbScheduleDay" SelectedIndex="0" MaxWidth="260" HorizontalAlignment="Left"
                                              AutomationProperties.Name="Scheduled weekly day">
                                        <ComboBoxItem Content="Monday" Tag="Monday"/>
                                        <ComboBoxItem Content="Tuesday" Tag="Tuesday"/>
                                        <ComboBoxItem Content="Wednesday" Tag="Wednesday"/>
                                        <ComboBoxItem Content="Thursday" Tag="Thursday"/>
                                        <ComboBoxItem Content="Friday" Tag="Friday"/>
                                        <ComboBoxItem Content="Saturday" Tag="Saturday"/>
                                        <ComboBoxItem Content="Sunday" Tag="Sunday"/>
                                    </ComboBox>
                                    <TextBlock Text="Monthly jobs use the selected time on the default Task Scheduler monthly cadence; daily jobs ignore the weekly day."
                                               Style="{StaticResource EmptyStateBody}" TextAlignment="Left" HorizontalAlignment="Left"
                                               Margin="0,8,0,0"/>
                                </StackPanel>
                            </Grid>
                        </GroupBox>
                        <Grid Grid.Row="2" Margin="24,0,24,16">
                            <ListBox x:Name="lstScheduledJobs" ItemsSource="{Binding ScheduledJobs}" BorderThickness="0"
                                     Background="{DynamicResource MantleBrush}"
                                     AutomationProperties.Name="Registered DeepPurge scheduled jobs">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="10,8" ToolTip="{Binding Diagnostic}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.2*"/>
                                                <ColumnDefinition Width="0.8*"/>
                                                <ColumnDefinition Width="1.4*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextBrush}"/>
                                                <TextBlock Text="{Binding SecurityStatus}" FontSize="11"
                                                           Foreground="{DynamicResource SubtextBrush}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding RunLevel}" FontSize="11.5"
                                                           Foreground="{DynamicResource TextBrush}"/>
                                                <TextBlock Text="{Binding Principal}" FontSize="10.5"
                                                           Foreground="{DynamicResource SubtextBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="{Binding ExecutablePath}" FontFamily="Consolas"
                                                           FontSize="10.5" Foreground="{DynamicResource TextBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Arguments}" FontFamily="Consolas"
                                                           FontSize="10.5" Foreground="{DynamicResource SubtextBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Border Style="{StaticResource EmptyStateCard}"
                                    Visibility="{Binding ScheduledJobs, Converter={StaticResource EmptyCollectionVisConverter}}"
                                    AutomationProperties.Name="No scheduled cleaning jobs">
                                <StackPanel>
                                    <TextBlock Text="&#xE823;" Style="{StaticResource EmptyStateIcon}"/>
                                    <TextBlock Text="No scheduled cleaning jobs are active" Style="{StaticResource EmptyStateTitle}"/>
                                    <TextBlock Text="Create a constrained job here, then refresh to confirm Task Scheduler registration."
                                               Style="{StaticResource EmptyStateBody}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- ═══════════════════════════════════════════════════════ -->
                    <!-- INSTALL MONITOR ("Track This Installer" flow)            -->
                    <!-- ═══════════════════════════════════════════════════════ -->
                    <Border x:Name="panelInstallMonitor" Visibility="Collapsed"
                            AutomationProperties.Name="Install Monitor panel"
                            AutomationProperties.HelpText="Capture before and after snapshots of an installer to build an exact removal manifest.">
                        <Border Padding="60,48" MaxWidth="620" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <StackPanel>
                                <Border Width="52" Height="52" CornerRadius="14" Margin="0,0,0,24" HorizontalAlignment="Left">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="{DynamicResource AccentColor}" Offset="0"/>
                                            <GradientStop Color="{DynamicResource TealColor}" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Border.Effect>
                                        <DropShadowEffect Color="{DynamicResource AccentColor}" BlurRadius="18" ShadowDepth="0" Opacity="0.25"/>
                                    </Border.Effect>
                                    <TextBlock Text="&#xE8B5;" FontFamily="{StaticResource Ico}" FontSize="22" Foreground="#FFFFFF"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Track This Installer" FontSize="24" FontWeight="Bold" Margin="0,0,0,8"
                                           Foreground="{DynamicResource TextBrush}"/>
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource SubtextBrush}"
                                           Margin="0,0,0,32" FontSize="13" LineHeight="21">
                                    Captures the full filesystem + registry state before and after an installer runs.
                                    The resulting delta becomes a precise removal manifest for forced uninstall.
                                </TextBlock>

                                <TextBlock Text="PROGRAM NAME" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Subtext0Brush}" Margin="2,0,0,8" Opacity="0.6"/>
                                <TextBox x:Name="txtMonitorName" Margin="0,0,0,22"
                                         AutomationProperties.Name="Program name for install trace"/>

                                <TextBlock Text="INSTALLER PATH" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Subtext0Brush}" Margin="2,0,0,8" Opacity="0.6"/>
                                <DockPanel Margin="0,0,0,22">
                                    <Button DockPanel.Dock="Right" Content="Browse" Click="BrowseInstaller_Click" Margin="10,0,0,0" Padding="20,9"/>
                                    <TextBox x:Name="txtMonitorInstaller"
                                             AutomationProperties.Name="Path to installer executable"/>
                                </DockPanel>

                                <TextBlock Text="INSTALLER ARGUMENTS  (optional)" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Subtext0Brush}" Margin="2,0,0,8" Opacity="0.6"/>
                                <TextBox x:Name="txtMonitorArgs" Margin="0,0,0,32"
                                         AutomationProperties.Name="Optional installer arguments"/>

                                <Button Content="Start Trace" Style="{DynamicResource AccentButton}"
                                        Click="StartInstallTrace_Click" HorizontalAlignment="Left" Padding="32,11" FontSize="13"
                                        AutomationProperties.Name="Begin install trace capture"/>

                                <TextBlock Text="{Binding SnapshotStatus}" TextWrapping="Wrap" Margin="0,24,0,0"
                                           Foreground="{DynamicResource SubtextBrush}" FontSize="12.5"/>
                            </StackPanel>
                        </Border>
                    </Border>

                    <!-- ═══════════════════════════════════════════════════════ -->
                    <!-- HEALTH DASHBOARD                                      -->
                    <!-- ═══════════════════════════════════════════════════════ -->
                    <Grid x:Name="panelHealth" Visibility="Collapsed"
                          AutomationProperties.Name="Health Dashboard panel"
                          AutomationProperties.HelpText="Score junk, privacy, startup, and disk hygiene with partial-scan diagnostics.">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Padding="36,28,36,12">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Run Health Check"
                                        Command="{Binding RunHealthCheckCommand}"
                                        Style="{DynamicResource AccentButton}" Padding="22,9"
                                        AutomationProperties.Name="Run health check"/>
                                <StackPanel>
                                    <TextBlock Text="Health Dashboard" FontSize="24" FontWeight="Bold"
                                               Foreground="{DynamicResource TextBrush}"/>
                                    <TextBlock Text="{Binding HealthSummary}" TextWrapping="Wrap"
                                               Foreground="{DynamicResource SubtextBrush}" Margin="0,6,24,0"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <Border Grid.Row="1" Margin="36,0,36,14" Padding="16"
                                Background="{DynamicResource Surface0Brush}"
                                BorderBrush="{DynamicResource Surface1Brush}" BorderThickness="1" CornerRadius="10">
                            <StackPanel Orientation="Horizontal">
                                <StackPanel Margin="0,0,32,0">
                                    <TextBlock Text="OVERALL SCORE" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Subtext0Brush}"/>
                                    <TextBlock Text="{Binding HealthOverallScore, StringFormat={}{0}/100}" FontSize="28"
                                               FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,32,0">
                                    <TextBlock Text="GRADE" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Subtext0Brush}"/>
                                    <TextBlock Text="{Binding HealthGrade}" FontSize="28" FontWeight="Bold"
                                               Foreground="{DynamicResource TextBrush}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding HealthTrendDisplay}" VerticalAlignment="Center"
                                           Foreground="{DynamicResource SubtextBrush}" FontSize="12"/>
                            </StackPanel>
                        </Border>

                        <DataGrid Grid.Row="2" AutoGenerateColumns="False" ItemsSource="{Binding HealthCategories}"
                                  AutomationProperties.Name="Health category scores">
                            <DataGrid.Columns>
                                <DataGridTextColumn Binding="{Binding Category}" Header="CATEGORY" Width="160"/>
                                <DataGridTextColumn Binding="{Binding Score, StringFormat={}{0}/100}" Header="SCORE" Width="90"/>
                                <DataGridTextColumn Binding="{Binding Summary}" Header="SUMMARY" Width="*"/>
                                <DataGridTextColumn Binding="{Binding Action}" Header="RECOMMENDATION" Width="190"/>
                                <DataGridTextColumn Binding="{Binding CommandTarget}" Header="TARGET" Width="130"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border Style="{StaticResource EmptyStateCard}" Panel.ZIndex="5"
                                AutomationProperties.Name="No health assessment results">
                            <Border.Visibility>
                                <MultiBinding Converter="{StaticResource PanelEmptyStateVisConverter}" ConverterParameter="Health">
                                    <Binding Path="CurrentPanel"/>
                                    <Binding Path="HealthCategories.Count"/>
                                </MultiBinding>
                            </Border.Visibility>
                            <StackPanel>
                                <TextBlock Text="&#xE9D9;" Style="{StaticResource EmptyStateIcon}"/>
                                <TextBlock Text="Run a health check to score this system" Style="{StaticResource EmptyStateTitle}"/>
                                <TextBlock Text="DeepPurge checks junk, privacy traces, startup impact, and free disk space. Partial results include the source diagnostics that need attention."
                                           Style="{StaticResource EmptyStateBody}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- ═══════════════════════════════════════════════════════ -->
                    <!-- SYSTEM SLIMMING                                        -->
                    <!-- ═══════════════════════════════════════════════════════ -->
                    <Grid x:Name="panelSlimming" Visibility="Collapsed"
                          AutomationProperties.Name="System Slimming panel"
                          AutomationProperties.HelpText="Review removable Windows components before an expert-mode guarded deletion.">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Padding="36,28,36,14">
                            <DockPanel>
                                <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                                    <Button Content="Scan Components" Command="{Binding ScanSlimmableCommand}"
                                            Style="{DynamicResource AccentButton}" Margin="0,0,8,0"
                                            Padding="18,9" AutomationProperties.Name="Scan removable Windows components"/>
                                    <Button Content="Remove Selected" Command="{Binding RunSlimCommand}"
                                            IsEnabled="{Binding ExpertMode}" Style="{DynamicResource DangerButton}"
                                            Padding="18,9" AutomationProperties.Name="Remove selected Windows components"/>
                                </WrapPanel>
                                <StackPanel>
                                    <TextBlock Text="System Slimming" FontSize="24" FontWeight="Bold"
                                               Foreground="{DynamicResource TextBrush}"/>
                                    <TextBlock Text="{Binding SlimSummary}" TextWrapping="Wrap"
                                               Foreground="{DynamicResource SubtextBrush}" Margin="0,6,24,0"/>
                                    <TextBlock Text="Review each component. Enable Dry Run to preview the guarded deletion result before making changes."
                                               TextWrapping="Wrap" Foreground="{DynamicResource PeachBrush}" Margin="0,6,24,0"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <DataGrid Grid.Row="1" AutoGenerateColumns="False" ItemsSource="{Binding SlimmableComponents}"
                                  AutomationProperties.Name="Removable Windows components">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Binding="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Header="REMOVE" Width="70"/>
                                <DataGridTextColumn Binding="{Binding Name}" Header="COMPONENT" Width="220"/>
                                <DataGridTextColumn Binding="{Binding Category}" Header="CATEGORY" Width="110"/>
                                <DataGridTextColumn Binding="{Binding Description}" Header="DESCRIPTION" Width="*"/>
                                <DataGridTextColumn Binding="{Binding SizeBytes, Converter={StaticResource BytesToSizeConverter}}" Header="SIZE" Width="95"/>
                                <DataGridTextColumn Binding="{Binding Path}" Header="PATH" Width="260"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border Style="{StaticResource EmptyStateCard}" Panel.ZIndex="5"
                                AutomationProperties.Name="No removable Windows components">
                            <Border.Visibility>
                                <MultiBinding Converter="{StaticResource PanelEmptyStateVisConverter}" ConverterParameter="Slimming">
                                    <Binding Path="CurrentPanel"/>
                                    <Binding Path="SlimmableComponents.Count"/>
                                </MultiBinding>
                            </Border.Visibility>
                            <StackPanel>
                                <TextBlock Text="&#xE7F4;" Style="{StaticResource EmptyStateIcon}"/>
                                <TextBlock Text="Scan for removable Windows components" Style="{StaticResource EmptyStateTitle}"/>
                                <TextBlock Text="Only existing, non-empty directories are shown. Reparse points and protected paths are rejected by SafetyGuard before deletion."
                                           Style="{StaticResource EmptyStateBody}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- ═══════════════════════════════════════════════════════ -->
                    <!-- ACTIVITY HISTORY                                         -->
                    <!-- ═══════════════════════════════════════════════════════ -->
                    <DataGrid x:Name="dgHistory" Visibility="Collapsed" AutoGenerateColumns="False"
                              ItemsSource="{Binding HistoryEntries}"
                              AutomationProperties.Name="Activity history"
                              AutomationProperties.HelpText="Prior uninstall, cleanup, and repair activity.">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Copy All to Clipboard" Tag="&#xE8C8;" Command="{Binding CopyHistoryToClipboardCommand}"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding TimestampUtc, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Header="DATE (UTC)" Width="140"/>
                            <DataGridTextColumn Binding="{Binding Operation}" Header="OPERATION" Width="120"/>
                            <DataGridTextColumn Binding="{Binding Summary}" Header="SUMMARY" Width="*"/>
                            <DataGridTextColumn Binding="{Binding ItemCount}" Header="ITEMS" Width="70"/>
                            <DataGridTextColumn Binding="{Binding BytesFreed, Converter={StaticResource BytesToSizeConverter}}" Header="FREED" Width="90"/>
                            <DataGridTextColumn Binding="{Binding DryRun}" Header="DRY RUN" Width="75"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border Style="{StaticResource EmptyStateCard}" Panel.ZIndex="5"
                            AutomationProperties.Name="No activity history found">
                        <Border.Visibility>
                            <MultiBinding Converter="{StaticResource PanelEmptyStateVisConverter}" ConverterParameter="History">
                                <Binding Path="CurrentPanel"/>
                                <Binding Path="HistoryEntries.Count"/>
                            </MultiBinding>
                        </Border.Visibility>
                        <StackPanel>
                            <TextBlock Text="&#xE81C;" Style="{StaticResource EmptyStateIcon}"/>
                            <TextBlock Text="No activity recorded yet" Style="{StaticResource EmptyStateTitle}"/>
                            <TextBlock Text="Uninstall, cleanup, restore, and repair actions will appear here with timestamps and dry-run status."
                                       Style="{StaticResource EmptyStateBody}"/>
                        </StackPanel>
                    </Border>

                    <!-- SETTINGS / PRIVACY -->
                    <ScrollViewer x:Name="panelSettings" Visibility="Collapsed" Padding="36,28"
                                  VerticalScrollBarVisibility="Auto"
                                  AutomationProperties.Name="Settings and Privacy panel"
                                  AutomationProperties.HelpText="Saved DeepPurge settings for exclusions, cookie preservation, age filters, and safety defaults.">
                        <StackPanel MaxWidth="900" HorizontalAlignment="Left">
                            <TextBlock Text="Settings / Privacy" FontSize="26" FontWeight="Bold"
                                       Foreground="{DynamicResource TextBrush}" Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding SettingsSummary}" TextWrapping="Wrap"
                                       Foreground="{DynamicResource SubtextBrush}" FontSize="12.5"
                                       Margin="0,0,0,24"/>

                            <GroupBox Header="Safety defaults" Margin="0,0,0,18">
                                <StackPanel>
                                    <CheckBox IsChecked="{Binding ExpertMode}" HorizontalAlignment="Left" Margin="0,0,0,12"
                                              AutomationProperties.Name="Enable expert mode">
                                        <TextBlock Text="Expert mode shows advanced operations such as registry hunter, service deletion, and high-risk cleanup controls."
                                                   TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}"/>
                                    </CheckBox>
                                    <CheckBox IsChecked="{Binding DryRunEnabled}" HorizontalAlignment="Left" Margin="0,0,0,12"
                                              AutomationProperties.Name="Enable dry run by default for this session">
                                        <TextBlock Text="Dry Run previews cleanup results without deleting anything during this session."
                                                   TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}"/>
                                    </CheckBox>
                                    <CheckBox IsChecked="{Binding SecureDeleteEnabled}" IsEnabled="{Binding ExpertMode}" HorizontalAlignment="Left"
                                              AutomationProperties.Name="Enable secure delete by default for this session">
                                        <TextBlock Text="Secure Delete overwrites selected files before deletion and disables Recycle Bin recovery."
                                                   TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}"/>
                                    </CheckBox>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="Age guardrails" Margin="0,0,0,18">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Junk minimum age (days)" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextBrush}" Margin="0,0,0,6"/>
                                        <TextBox Text="{Binding SettingsMinAgeJunkText, UpdateSourceTrigger=PropertyChanged}"
                                                 AutomationProperties.Name="Junk minimum age in days"/>
                                        <TextBlock Text="0 cleans eligible junk immediately. Higher values preserve newer cache files."
                                                   Style="{StaticResource EmptyStateBody}" TextAlignment="Left"
                                                   HorizontalAlignment="Left" Margin="0,8,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Evidence minimum age (days)" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextBrush}" Margin="0,0,0,6"/>
                                        <TextBox Text="{Binding SettingsMinAgeEvidenceText, UpdateSourceTrigger=PropertyChanged}"
                                                 AutomationProperties.Name="Evidence minimum age in days"/>
                                        <TextBlock Text="Use this to keep very recent browser and privacy traces during cleanup."
                                                   Style="{StaticResource EmptyStateBody}" TextAlignment="Left"
                                                   HorizontalAlignment="Left" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="Logs and recovery data" Margin="0,0,0,18">
                                <StackPanel>
                                    <TextBlock Text="Retention values use days. Set a value to 0 to keep that data until you prune it manually."
                                               Foreground="{DynamicResource SubtextBrush}" TextWrapping="Wrap" FontSize="12.5"
                                               Margin="0,0,0,12"/>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="14"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="14"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Log retention" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextBrush}" Margin="0,0,0,6"/>
                                            <TextBox Text="{Binding SettingsRetentionLogsText, UpdateSourceTrigger=PropertyChanged}"
                                                     AutomationProperties.Name="Log retention in days"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Activity retention" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextBrush}" Margin="0,0,0,6"/>
                                            <TextBox Text="{Binding SettingsRetentionActivityText, UpdateSourceTrigger=PropertyChanged}"
                                                     AutomationProperties.Name="Activity retention in days"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="Manifest retention" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextBrush}" Margin="0,0,0,6"/>
                                            <TextBox Text="{Binding SettingsRetentionDeletionManifestsText, UpdateSourceTrigger=PropertyChanged}"
                                                     AutomationProperties.Name="Deletion manifest retention in days"/>
                                        </StackPanel>
                                    </Grid>
                                    <CheckBox IsChecked="{Binding SettingsScrubSensitivePaths}" HorizontalAlignment="Left"
                                              AutomationProperties.Name="Scrub local paths in reports">
                                        <TextBlock Text="Scrub local paths in history and manifest previews. Rollback manifests stay intact for recovery."
                                                   TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}"/>
                                    </CheckBox>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="Cookie preservation" Margin="0,0,0,18">
                                <StackPanel>
                                    <TextBlock Text="One domain per line or comma-separated. When any domain is listed, browser cookie databases are preserved during Evidence cleaning."
                                               Foreground="{DynamicResource SubtextBrush}" TextWrapping="Wrap" FontSize="12.5"
                                               Margin="0,0,0,10"/>
                                    <TextBox Text="{Binding SettingsCookieWhitelistText, UpdateSourceTrigger=PropertyChanged}"
                                             AcceptsReturn="True" TextWrapping="Wrap" Height="120"
                                             VerticalScrollBarVisibility="Auto"
                                             AutomationProperties.Name="Cookie whitelist domains"/>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="Excluded paths" Margin="0,0,0,18">
                                <StackPanel>
                                    <TextBlock Text="One path per line. Safety checks skip these paths when scanning or deleting leftovers."
                                               Foreground="{DynamicResource SubtextBrush}" TextWrapping="Wrap" FontSize="12.5"
                                               Margin="0,0,0,10"/>
                                    <TextBox Text="{Binding SettingsExcludedPathsText, UpdateSourceTrigger=PropertyChanged}"
                                             AcceptsReturn="True" TextWrapping="Wrap" Height="130"
                                             VerticalScrollBarVisibility="Auto"
                                             AutomationProperties.Name="Excluded cleanup paths"/>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ═══════════════════════════════════════════════════════ -->
                    <!-- ABOUT / UPDATES                                         -->
                    <!-- ═══════════════════════════════════════════════════════ -->
                    <Border x:Name="panelAbout" Visibility="Collapsed" Padding="48,32"
                            AutomationProperties.Name="About and Updates panel"
                            AutomationProperties.HelpText="Application version, data location, portable mode status, local trust facts, and update check.">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel MaxWidth="760" HorizontalAlignment="Left" VerticalAlignment="Top">
                                <TextBlock Text="DeepPurge" FontSize="32" FontWeight="Bold"
                                           Foreground="{DynamicResource TextBrush}" Margin="0,0,0,2"/>
                                <TextBlock Text="{Binding AppVersionDisplay, StringFormat=Version {0}}" FontSize="13"
                                           Foreground="{DynamicResource SubtextBrush}" Margin="0,0,0,24"/>

                                <Border Background="{DynamicResource Surface0Brush}" BorderBrush="{DynamicResource Surface1Brush}"
                                        BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,20">
                                    <StackPanel>
                                        <TextBlock Text="Local data and runtime" FontSize="15" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextBrush}" Margin="0,0,0,14"/>

                                        <TextBlock Text="Data location" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding DataRootDisplay}" FontFamily="Consolas,Cascadia Code"
                                                   FontSize="12" Foreground="{DynamicResource SubtextBrush}" Margin="0,0,0,16"
                                                   TextWrapping="Wrap"/>

                                        <TextBlock Text="Portable mode" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding PortableStatusDisplay}" FontSize="12"
                                                   Foreground="{DynamicResource SubtextBrush}" Margin="0,0,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="{DynamicResource Surface0Brush}" BorderBrush="{DynamicResource Surface1Brush}"
                                        BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,20">
                                    <StackPanel>
                                        <TextBlock Text="Executable trust" FontSize="15" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextBrush}" Margin="0,0,0,14"/>

                                        <TextBlock Text="Running executable" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding ExecutablePathDisplay}" FontFamily="Consolas,Cascadia Code"
                                                   FontSize="12" Foreground="{DynamicResource SubtextBrush}" Margin="0,0,0,16"
                                                   TextWrapping="Wrap"/>

                                        <TextBlock Text="Signing status" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding LocalSignatureDisplay}" FontSize="12"
                                                   Foreground="{DynamicResource SubtextBrush}" Margin="0,0,0,16" TextWrapping="Wrap"/>

                                        <TextBlock Text="SHA256" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding LocalSha256Display}" FontFamily="Consolas,Cascadia Code"
                                                   FontSize="12" Foreground="{DynamicResource SubtextBrush}" Margin="0,0,0,16"
                                                   TextWrapping="Wrap"/>

                                        <TextBlock Text="{Binding ReleaseVerificationText}" FontSize="12"
                                                   Foreground="{DynamicResource Subtext0Brush}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                                        <TextBlock Text="Online Verification" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding ChecksumVerifyDisplay}" FontSize="12"
                                                   Foreground="{DynamicResource SubtextBrush}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                        <Button Content="Verify against release" Command="{Binding VerifyReleaseChecksumCommand}"
                                                Style="{DynamicResource AccentButton}" HorizontalAlignment="Left" Padding="24,10"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="{DynamicResource Surface0Brush}" BorderBrush="{DynamicResource Surface1Brush}"
                                        BorderThickness="1" CornerRadius="12" Padding="18">
                                    <StackPanel>
                                        <TextBlock Text="Updates" FontSize="15" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextBrush}" Margin="0,0,0,6"/>
                                        <TextBlock Text="{Binding UpdateText}" FontSize="12"
                                                   Foreground="{DynamicResource SubtextBrush}" Margin="0,0,0,12" TextWrapping="Wrap"/>
                                        <Button Content="Check for updates" Command="{Binding CheckForUpdatesCommand}"
                                                Style="{DynamicResource AccentButton}" HorizontalAlignment="Left" Padding="24,10"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="{DynamicResource Surface0Brush}" BorderBrush="{DynamicResource Surface1Brush}"
                                        BorderThickness="1" CornerRadius="12" Padding="18">
                                    <StackPanel>
                                        <TextBlock Text="Support Bundle" FontSize="15" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextBrush}" Margin="0,0,0,6"/>
                                        <TextBlock Text="Export a redacted diagnostic ZIP for bug reports. Contains doctor results, recent activity, logs, package-source health, and trust facts. All user-profile paths are automatically scrubbed."
                                                   FontSize="12" Foreground="{DynamicResource SubtextBrush}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding SupportBundleStatus}" FontSize="12"
                                                   Foreground="{DynamicResource Subtext0Brush}" Margin="0,0,0,12" TextWrapping="Wrap"/>
                                        <Button Content="Export support bundle" Command="{Binding ExportSupportBundleCommand}"
                                                Style="{DynamicResource AccentButton}" HorizontalAlignment="Left" Padding="24,10"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- LEFTOVER RESULTS OVERLAY -->
                    <Border x:Name="panelLeftovers" Visibility="Collapsed" Background="{DynamicResource BaseBrush}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Padding="24,16" Background="{DynamicResource MantleBrush}" CornerRadius="14,14,0,0">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Back" Click="BackToPrograms_Click"
                                            Style="{DynamicResource GhostButton}" Padding="20,8"/>
                                    <StackPanel>
                                        <TextBlock x:Name="txtLeftoverTitle" Text="{Binding LeftoverTitle}" FontSize="17" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextBrush}"/>
                                        <TextBlock x:Name="txtLeftoverInfo" Text="{Binding LeftoverInfo}" FontSize="11.5"
                                                   Foreground="{DynamicResource SubtextBrush}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <TabControl Grid.Row="1">
                                <TabItem Header="Registry Leftovers">
                                    <DataGrid AutoGenerateColumns="False" x:Name="dgRegistryLeftovers" ItemsSource="{Binding RegistryLeftovers}">
                                        <DataGrid.Columns>
                                            <DataGridCheckBoxColumn Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="44"
                                                                    HeaderTemplate="{StaticResource MasterCheckboxHeader}"/>
                                            <DataGridTextColumn Binding="{Binding DisplayPath}" Header="REGISTRY PATH" Width="*"/>
                                            <DataGridTextColumn Binding="{Binding Details}" Header="DETAILS" Width="260"/>
                                            <DataGridTextColumn Binding="{Binding OwnershipDisplay}" Header="OWNERSHIP" Width="145"/>
                                            <DataGridTextColumn Binding="{Binding Confidence}" Header="SAFETY" Width="85"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </TabItem>
                                <TabItem Header="File Leftovers">
                                    <DataGrid AutoGenerateColumns="False" x:Name="dgFileLeftovers" ItemsSource="{Binding FileLeftovers}">
                                        <DataGrid.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Exclude from future scans" Tag="&#xE8F8;" Click="Ctx_ExcludePath_Click"/>
                                            </ContextMenu>
                                        </DataGrid.ContextMenu>
                                        <DataGrid.Columns>
                                            <DataGridCheckBoxColumn Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="44"
                                                                    HeaderTemplate="{StaticResource MasterCheckboxHeader}"/>
                                            <DataGridTextColumn Binding="{Binding DisplayPath}" Header="PATH" Width="*"/>
                                            <DataGridTextColumn Binding="{Binding SizeDisplay}" Header="SIZE" Width="95"/>
                                            <DataGridTextColumn Binding="{Binding Details}" Header="DETAILS" Width="220"/>
                                            <DataGridTextColumn Binding="{Binding OwnershipDisplay}" Header="OWNERSHIP" Width="145"/>
                                            <DataGridTextColumn Binding="{Binding Confidence}" Header="SAFETY" Width="85"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </TabItem>
                            </TabControl>
                            <Border Grid.Row="2" Padding="20,12" Background="{DynamicResource MantleBrush}">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Content="Select Safe" Click="SelectAllSafe_Click" Margin="0,0,6,0"/>
                                        <Button Content="Deselect All" Click="DeselectAll_Click" Margin="0,0,12,0"/>
                                        <Button Content="Delete Selected" Click="DeleteLeftovers_Click"
                                                Style="{DynamicResource DangerButton}"/>
                                    </StackPanel>
                                    <TextBlock x:Name="txtLeftoverStats" Text="{Binding LeftoverStats}" VerticalAlignment="Center"
                                               Foreground="{DynamicResource SubtextBrush}" FontSize="12"/>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- ═══════════════════════════════════════════════════════ -->
            <!-- STATUS BAR -->
            <!-- ═══════════════════════════════════════════════════════ -->
            <Border Grid.Row="2" Padding="20,9,20,10" Background="{DynamicResource MantleBrush}"
                    BorderBrush="{DynamicResource Surface0Brush}" BorderThickness="0,1,0,0">
                <DockPanel>
                    <ProgressBar x:Name="progressBar" Width="140" Height="4" DockPanel.Dock="Right"
                                  Margin="16,0,0,0" VerticalAlignment="Center"
                                  Value="{Binding OperationProgress}"
                                  Visibility="{Binding OperationProgressVisible, Converter={StaticResource BoolToVis}}"/>
                    <ProgressBar x:Name="busyBar" Width="140" Height="4" DockPanel.Dock="Right"
                                  Margin="16,0,0,0" VerticalAlignment="Center" IsIndeterminate="True">
                        <ProgressBar.Style>
                            <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsBusy}" Value="True"/>
                                            <Condition Binding="{Binding OperationProgressVisible}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>

                    <Border DockPanel.Dock="Right" CornerRadius="5" Padding="9,4" Margin="10,0,0,0"
                            VerticalAlignment="Center" Background="{DynamicResource BaseBrush}"
                            BorderBrush="{DynamicResource Surface1Brush}" BorderThickness="1">
                        <CheckBox x:Name="chkSecure" IsChecked="{Binding SecureDeleteEnabled}" IsEnabled="{Binding ExpertMode}"
                                  VerticalAlignment="Center"
                                  AutomationProperties.Name="Secure delete mode"
                                  ToolTip="Overwrite file contents before unlink. Slower; no recycle-bin recovery.">
                            <TextBlock Text="Secure delete" FontSize="10.5" FontWeight="Medium"
                                       Foreground="{DynamicResource RedBrush}" VerticalAlignment="Center"
                                       Margin="6,0,0,0"/>
                        </CheckBox>
                    </Border>

                    <Border DockPanel.Dock="Right" CornerRadius="5" Padding="9,4" Margin="10,0,0,0"
                            VerticalAlignment="Center" Background="{DynamicResource BaseBrush}"
                            BorderBrush="{DynamicResource Surface1Brush}" BorderThickness="1">
                        <CheckBox x:Name="chkDryRun" IsChecked="{Binding DryRunEnabled}"
                                  VerticalAlignment="Center"
                                  AutomationProperties.Name="Preview mode"
                                  ToolTip="Preview: enumerate and size items without deleting">
                            <TextBlock Text="Preview mode" FontSize="10.5" FontWeight="Medium"
                                       Foreground="{DynamicResource YellowBrush}" VerticalAlignment="Center"
                                       Margin="6,0,0,0"/>
                        </CheckBox>
                    </Border>

                    <!-- Live progress text when an operation is running -->
                    <Border DockPanel.Dock="Right" CornerRadius="5" Padding="9,4" Margin="10,0,0,0"
                            VerticalAlignment="Center" Background="{DynamicResource BaseBrush}"
                            BorderBrush="{DynamicResource Surface1Brush}" BorderThickness="1"
                            Visibility="{Binding OperationProgressVisible, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding OperationProgressText}" FontSize="10.5" FontWeight="Medium"
                                   Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" MaxWidth="300"/>
                    </Border>

                    <!-- Junk total badge -->
                    <Border DockPanel.Dock="Right" CornerRadius="5" Padding="9,4" Margin="10,0,0,0"
                            VerticalAlignment="Center" Background="{DynamicResource BaseBrush}"
                            BorderBrush="{DynamicResource Surface1Brush}" BorderThickness="1">
                        <TextBlock Text="{Binding TotalJunkDisplay}" FontSize="10.5" FontWeight="Medium"
                                   Foreground="{DynamicResource PeachBrush}" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Selected count badge -->
                    <Border DockPanel.Dock="Right" CornerRadius="5" Padding="9,4" Margin="10,0,0,0"
                            VerticalAlignment="Center" Background="{DynamicResource BaseBrush}"
                            BorderBrush="{DynamicResource Surface1Brush}" BorderThickness="1"
                            Visibility="{Binding SelectedCountBadge, Converter={StaticResource BadgeVisConverter}}">
                        <TextBlock Text="{Binding SelectedCountBadge}" FontSize="10.5" FontWeight="Medium"
                                   Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE73E;" FontFamily="{StaticResource Ico}" FontSize="12"
                                   Foreground="{DynamicResource GreenBrush}" Margin="0,0,8,0"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtStatus" Text="{Binding StatusText}" Foreground="{DynamicResource SubtextBrush}"
                                   FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                   AutomationProperties.LiveSetting="Polite"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ═══════════════════════════════════════════════════════ -->
            <!-- TOAST NOTIFICATION -->
            <!-- ═══════════════════════════════════════════════════════ -->
            <Border x:Name="toastPanel" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,16,24,0" Padding="16,10,20,10" CornerRadius="7" Opacity="0"
                    IsHitTestVisible="False" Panel.ZIndex="999"
                    Background="{DynamicResource MantleBrush}"
                    BorderBrush="{DynamicResource Surface1Brush}" BorderThickness="1"
                    AutomationProperties.Name="DeepPurge notification"
                    AutomationProperties.LiveSetting="Polite">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.35" Color="#000000"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="toastIcon" Text="&#xE73E;" FontFamily="{StaticResource Ico}" FontSize="14"
                               Foreground="{DynamicResource GreenBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="toastText" Text="" FontSize="12" FontWeight="Medium"
                               Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" MaxWidth="400"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- LOADING OVERLAY (spans entire window) -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <Border x:Name="LoadingOverlay" Grid.ColumnSpan="2" Visibility="Visible" Opacity="1">
            <Border.Background>
                <SolidColorBrush Color="{DynamicResource CrustColor}" Opacity="0.92"/>
            </Border.Background>
            <Grid>
                <!-- Subtle gradient vignette -->
                <Border IsHitTestVisible="False">
                    <Border.Background>
                        <RadialGradientBrush Center="0.5,0.45" RadiusX="0.55" RadiusY="0.7">
                            <GradientStop Color="#00000000" Offset="0"/>
                            <GradientStop Color="#12000000" Offset="1"/>
                        </RadialGradientBrush>
                    </Border.Background>
                </Border>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- Logo icon with glow -->
                    <Border Width="68" Height="68" CornerRadius="16" HorizontalAlignment="Center" Margin="0,0,0,28">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="{DynamicResource AccentColor}" Offset="0"/>
                                <GradientStop Color="{DynamicResource TealColor}" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Effect>
                            <DropShadowEffect Color="{DynamicResource AccentColor}" BlurRadius="24" ShadowDepth="0" Opacity="0.22"/>
                        </Border.Effect>
                        <TextBlock Text="&#xE74D;" FontFamily="{StaticResource Ico}" FontSize="28"
                                   Foreground="{StaticResource ActionForegroundBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- App name -->
                    <TextBlock Text="DeepPurge" FontSize="27" FontWeight="Bold"
                               Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                    <TextBlock Text="LOCAL SYSTEM CARE" FontSize="9.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource Subtext0Brush}" HorizontalAlignment="Center"
                               Margin="0,0,0,4" Opacity="0.72"/>
                    <TextBlock FontSize="10.5" FontWeight="Medium"
                               Foreground="{DynamicResource Subtext0Brush}" HorizontalAlignment="Center" Margin="0,0,0,26"
                               Opacity="0.5" Text="{Binding AppVersionDisplay, StringFormat=v{0}}"/>

                    <!-- Status text -->
                    <TextBlock Text="{Binding ScanOverlayText}" FontSize="14" FontWeight="Medium"
                               Foreground="{DynamicResource SubtextBrush}" HorizontalAlignment="Center" Margin="0,0,0,16"/>

                    <!-- Big percentage readout -->
                    <TextBlock Text="{Binding OverlayScanProgress, StringFormat={}{0:F0}%}"
                               FontSize="42" FontWeight="Bold"
                               Foreground="{DynamicResource AccentBrush}"
                               HorizontalAlignment="Center" Margin="0,0,0,10"/>

                    <!-- Determinate progress bar, driven by the scan's step counter. -->
                    <ProgressBar Width="320" Height="6"
                                 Value="{Binding OverlayScanProgress}" Maximum="100"
                                 Foreground="{DynamicResource AccentBrush}"
                                 Background="{DynamicResource Surface0Brush}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
